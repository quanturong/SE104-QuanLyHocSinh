<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Quên mật khẩu</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="auth">
  <main class="auth-card">
    <div class="auth-logo">
      <img src="/img/login.png" alt="Logo" />
    </div>

    <h1 class="auth-title">Quên mật khẩu</h1>

    <% if (error) { %>
      <p class="auth-error"><%= error %></p>
    <% } %>

    <% if (success) { %>
      <p class="auth-success"><%= success %></p>
    <% } %>

    <form class="auth-form" method="POST" action="/change-password">
      <label class="auth-label">
        Tên đăng nhập
        <input
          type="text"
          name="username"
          class="auth-input"
          placeholder="Nhập tên đăng nhập"
          required
        />
      </label>
      <label class="auth-label">
        Mật khẩu mới
        <input
          type="password"
          name="newPassword"
          class="auth-input"
          placeholder="Nhập mật khẩu mới"
          required
        />
      </label>
      <label class="auth-label">
        Xác nhận mật khẩu mới
        <input
          type="password"
          name="confirmPassword"
          class="auth-input"
          placeholder="Nhập lại mật khẩu mới"
          required
        />
      </label>

      <button class="auth-btn">Đặt lại mật khẩu</button>

      <a class="auth-link" href="/login">Quay lại đăng nhập</a>
    </form>
  </main>
</body>
</html>
