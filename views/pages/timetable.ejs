<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Thời khóa biểu – Quản lí học sinh</title>
  <link rel="stylesheet" href="/css/style.css" />

</head>
<body class="page-student">
  <div class="layout">
    <% 
      const canEditTimetable = permissions && permissions.canEditTimetable; 
    %>
    <%- include('../partials/sidebar') %>
    <%- include('../partials/delete-confirm-modal') %>

    <main class="main">
      <div class="page-header">
        <h1 class="page-title">Thời khóa biểu</h1>
        <p class="page-desc">
          Chọn năm học, học kỳ và lớp để xem thời khóa biểu chi tiết theo từng tiết.
        </p>
        <% if (typeof error !== 'undefined' && error) { %>
          <div style="background: #fee; color: #c33; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #fcc;">
            <strong>❌ Lỗi:</strong> <%= error %>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div style="background: #efe; color: #3c3; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #cfc;">
            <strong>✅ Thành công:</strong> <%= success %>
          </div>
        <% } %>
      </div>

      <section class="card" style="margin-bottom:16px;">
        <div class="ttb-filter-inline">
          <div class="class-info-item">
            <label class="class-label">Năm học</label>
            <select class="select select-sm" id="ttb-year">
              <% if (typeof namHocs !== 'undefined' && namHocs && namHocs.length) { %>
                <% namHocs.forEach(function(nh){ %>
                  <option value="<%= nh.MaNamHoc %>" <%= (typeof selectedYear !== 'undefined' && selectedYear === nh.MaNamHoc) ? 'selected' : '' %>>
                    <%= nh.MaNamHoc %>
                  </option>
                <% }) %>
              <% } else { %>
                <option>Chưa có năm học</option>
              <% } %>
            </select>
          </div>

          <div class="class-info-item">
            <label class="class-label">Học kỳ</label>
            <select class="select select-sm" id="ttb-semester">
              <option value="1" <%= (typeof selectedSemester !== 'undefined' && selectedSemester === '1') ? 'selected' : '' %>>Học kỳ 1</option>
              <option value="2" <%= (typeof selectedSemester !== 'undefined' && selectedSemester === '2') ? 'selected' : '' %>>Học kỳ 2</option>
            </select>
          </div>

          <div class="class-info-item">
            <label class="class-label">Lớp</label>
            <% if (permissions && permissions.isStudent) { %>
              <!-- Học sinh không thể chọn lớp, chỉ hiển thị lớp của mình -->
              <input 
                type="text" 
                class="input input-sm" 
                id="ttb-class" 
                value="<%= typeof selectedClass !== 'undefined' && selectedClass ? selectedClass : 'Chưa có lớp' %>" 
                readonly 
                style="background:#f1f5f9; cursor:not-allowed;"
              />
              <input type="hidden" id="ttb-class-hidden" value="<%= typeof selectedClass !== 'undefined' && selectedClass ? selectedClass : '' %>" />
            <% } else { %>
              <select class="select select-sm" id="ttb-class">
                <% if (typeof classes !== 'undefined' && classes && classes.length) { %>
                  <% classes.forEach(function(c){ %>
                    <option value="<%= c.MaLop %>" <%= (typeof selectedClass !== 'undefined' && selectedClass === c.MaLop) ? 'selected' : '' %>>
                      <%= c.MaLop %>
                    </option>
                  <% }) %>
                <% } else { %>
                  <option>Chưa có lớp</option>
                <% } %>
              </select>
            <% } %>
          </div>
        </div>

        <p class="ttb-note" style="margin-top:10px;">
          Gợi ý: Kéo ngang bảng để xem đầy đủ các ngày trong tuần trên màn hình nhỏ.
          Mỗi ô hiển thị <strong>môn học</strong> và dòng dưới là <strong>tên giáo viên</strong>.
        </p>
      </section>

      <section class="card" id="timetable-section">
        <div class="table-wrap" style="overflow:auto; max-height:560px;">
          <table class="table tt-table" id="timetable-table">
            <thead>
              <tr>
                <th class="sticky-col tt-period">Tiết</th>
                <th class="tt-cell">Thứ 2</th>
                <th class="tt-cell">Thứ 3</th>
                <th class="tt-cell">Thứ 4</th>
                <th class="tt-cell">Thứ 5</th>
                <th class="tt-cell">Thứ 6</th>
                <th class="tt-cell">Thứ 7</th>
              </tr>
            </thead>
            <tbody id="ttb-body">
            </tbody>
          </table>
        </div>

        <% if (canEditTimetable) { %>
          <div style="display:flex;justify-content:flex-end;margin-top:14px;gap:8px;">
            <button class="btn-edit-tkb" id="btn-edit-tkb">🖊️ Sửa thời khóa biểu</button>
            <button class="btn-reset-tkb" id="btn-reset-tkb" type="button" onclick="resetTimetableConfirm()">🗑️ Đặt lại</button>
          </div>

          <form id="frm-reset-tkb" method="post" action="/timetable/reset" style="display:none;">
            <input type="hidden" name="MaLop" id="resetMaLop" />
            <input type="hidden" name="NamHoc" id="resetNamHoc" />
            <input type="hidden" name="HocKy" id="resetHocKy" />
          </form>
        <% } %>
      </section>
    <div class="sp-overlay" id="modal-edit-timetable" style="display:none;">
      <div class="sp-modal">
        <h2 class="sp-title">Sửa thời khóa biểu</h2>
        
        <form class="sp-form" id="form-edit-timetable" method="post" action="/timetable/save">
          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px;">
            <div class="sp-field">
              <label>Thứ</label>
              <select id="edit-thu" name="Thu">
                <option value="2">Thứ 2</option>
                <option value="3">Thứ 3</option>
                <option value="4">Thứ 4</option>
                <option value="5">Thứ 5</option>
                <option value="6">Thứ 6</option>
                <option value="7">Thứ 7</option>
              </select>
            </div>

            <div class="sp-field">
              <label>Tiết học</label>
              <select id="edit-tiet" name="TietHoc">
                <option value="1">Tiết 1</option>
                <option value="2">Tiết 2</option>
                <option value="3">Tiết 3</option>
                <option value="4">Tiết 4</option>
                <option value="5">Tiết 5</option>
                <option value="6">Tiết 6</option>
                <option value="7">Tiết 7</option>
                <option value="8">Tiết 8</option>
                <option value="9">Tiết 9</option>
                <option value="10">Tiết 10</option>
              </select>
            </div>

            <div class="sp-field">
              <label>Lớp</label>
              <input type="text" id="edit-lop-tkb" name="MaLop" readonly style="background:#f1f5f9; cursor:not-allowed;" />
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
            <div class="sp-field">
              <label>Năm học</label>
              <input type="text" id="edit-nam-hoc-tkb" name="NamHoc" readonly style="background:#f1f5f9; cursor:not-allowed;" />
            </div>

            <div class="sp-field">
              <label>Học kỳ</label>
              <select id="edit-hoc-ky-tkb" name="HocKy">
                <option value="1">Học kỳ 1</option>
                <option value="2">Học kỳ 2</option>
              </select>
            </div>
          </div>

          <div class="sp-field">
            <label>Môn học</label>
            <select id="edit-mon-hoc-tkb" name="MaMonHoc">
              <% if (typeof subjects !== 'undefined' && subjects && subjects.length) { %>
                <option value="">(Không chọn)</option>
                <% subjects.forEach(s => { %>
                  <option value="<%= s.MaMonHoc %>"><%= s.TenMonHoc %></option>
                <% }) %>
              <% } else { %>
                <option>Không có môn</option>
              <% } %>
            </select>
          </div>

          <div class="sp-field">
            <label>Giáo viên</label>
            <select id="edit-giao-vien-tkb" name="MaGiaoVien">
              <% if (typeof teachers !== 'undefined' && teachers && teachers.length) { %>
                <option value="">(Không chọn)</option>
                <% teachers.forEach(t => { %>
                  <option value="<%= t.MaGiaoVien %>"><%= t.HoTen %></option>
                <% }) %>
              <% } else { %>
                <option>Không có giáo viên</option>
              <% } %>
            </select>
          </div>

          <div class="sp-field">
            <label>Phòng học</label>
            <input type="text" id="edit-phong-hoc" name="PhongHoc" placeholder="VD: A101, B202..." />
          </div>

          <div class="sp-field">
            <label>Ghi chú</label>
            <textarea id="edit-ghi-chu-tkb" name="GhiChu" rows="2" placeholder="Ghi chú thêm (nếu có)..."></textarea>
          </div>

          <div class="sp-actions">
            <button type="button" class="sp-btn sp-btn--ghost" onclick="closeEditTimetableModal()">
              Đóng
            </button>
            <button type="submit" class="sp-btn">
              Lưu thay đổi
            </button>
          </div>
        </form>
      </div>
    </div>
    </main>
  </div>

  <script>
    const RAW_TKB  = <%- typeof timetables !== 'undefined' ? JSON.stringify(timetables) : '[]' %>;
    const CLASSES  = <%- typeof classes    !== 'undefined' ? JSON.stringify(classes)    : '[]' %>;
    const NAM_HOCS = <%- typeof namHocs    !== 'undefined' ? JSON.stringify(namHocs)    : '[]' %>;
    const SELECTED_YEAR = '<%= typeof selectedYear !== 'undefined' ? selectedYear : '' %>';
    const SELECTED_SEMESTER = '<%= typeof selectedSemester !== 'undefined' ? selectedSemester : '1' %>';
    const SELECTED_CLASS = '<%= typeof selectedClass !== 'undefined' ? selectedClass : '' %>';

    const ttbYearSel     = document.getElementById('ttb-year');
    const ttbSemesterSel = document.getElementById('ttb-semester');
    const ttbClassSel    = document.getElementById('ttb-class');
    const ttbBody        = document.getElementById('ttb-body');
    const CAN_EDIT_TKB   = <%= (permissions && permissions.canEditTimetable) ? 'true' : 'false' %>;

    function getAllPeriods(data) {
      const set = new Set();
      data.forEach(row => {
        if (row.TietHoc != null) set.add(row.TietHoc);
      });
      return Array.from(set).sort((a, b) => a - b);
    }

    function filterData() {
      const year = ttbYearSel.value || '';
      const semester = ttbSemesterSel.value || '';
      const lop = ttbClassSel.value || '';
      
      let filtered = RAW_TKB;
      
      // Lọc theo năm học
      if (year) {
        filtered = filtered.filter(row => row.NamHoc === year);
      }
      
      // Lọc theo lớp
      if (lop) {
        filtered = filtered.filter(row => row.MaLop === lop);
      }
      
      // Lọc theo học kỳ
      if (semester) {
        filtered = filtered.filter(row => row.HocKy === parseInt(semester, 10));
      } else {
        // Mặc định là học kỳ 1
        filtered = filtered.filter(row => row.HocKy === 1);
      }
      
      return filtered;
    }

    function cellContent(item) {
      if (!item) {
        return '<span class="tt-empty">—</span>';
      }
      const mon    = item.TenMonHoc   || item.MaMonHoc   || '';
      const gvName = item.TenGiaoVien || item.MaGiaoVien || '';
      return `
        <span class="tt-sub">${mon}</span>
        <span class="tt-teacher">${gvName}</span>
      `;
    }

    function renderTable() {
      const data = filterData();
      const timetableTable = document.getElementById('timetable-table');
      const timetableSection = document.getElementById('timetable-section');

      if (!data.length) {
        ttbBody.innerHTML = '';
        // Ẩn bảng và phần nút khi không có dữ liệu
        if (timetableTable) timetableTable.style.display = 'none';
        return;
      }

      // Hiển thị bảng khi có dữ liệu
      if (timetableTable) timetableTable.style.display = 'table';

      const periods = getAllPeriods(data);
      const days = [2, 3, 4, 5, 6, 7];

      const map = {};
      data.forEach(row => {
        const tiet = row.TietHoc;
        const thu  = row.Thu;
        if (!map[tiet]) map[tiet] = {};
        map[tiet][thu] = row;
      });

      let html = '';
      periods.forEach(tiet => {
        html += '<tr>';
        html += `<td class="sticky-col tt-period">${tiet}</td>`;
        days.forEach(thu => {
          const item = map[tiet] ? map[tiet][thu] : null;
          html += `<td class="tt-cell">${cellContent(item)}</td>`;
        });
        html += '</tr>';
      });

      ttbBody.innerHTML = html;
    }

    // On change we reload page so server can provide the filtered data (by year/semester/class)
    function reloadWithFilters() {
      const year = ttbYearSel.value;
      const semester = ttbSemesterSel.value;
      // Học sinh không thể thay đổi lớp, lấy từ hidden input hoặc select
      const cls = (ttbClassSel && ttbClassSel.value) || 
                  (document.getElementById('ttb-class-hidden') && document.getElementById('ttb-class-hidden').value) || 
                  '';
      const q = `?year=${encodeURIComponent(year)}&semester=${encodeURIComponent(semester)}${cls ? '&class='+encodeURIComponent(cls) : ''}`;
      window.location.href = '/timetable' + q;
    }

    // Chỉ cho phép thay đổi lớp nếu không phải học sinh
    const isStudent = <%= (permissions && permissions.isStudent) ? 'true' : 'false' %>;
    if (ttbClassSel && !isStudent) {
      ttbClassSel.addEventListener('change', reloadWithFilters);
    }
    ttbYearSel     && ttbYearSel.addEventListener('change', reloadWithFilters);
    ttbSemesterSel && ttbSemesterSel.addEventListener('change', reloadWithFilters);

    window.addEventListener('DOMContentLoaded', () => {
      // If the server provided selected values, ensure selects reflect them
      if (SELECTED_YEAR) ttbYearSel.value = SELECTED_YEAR;
      if (SELECTED_SEMESTER) ttbSemesterSel.value = SELECTED_SEMESTER;
      if (SELECTED_CLASS) ttbClassSel.value = SELECTED_CLASS;
      renderTable();
    });
    function openEditTimetableModal() {
      document.getElementById('modal-edit-timetable').style.display = 'grid';
    }

    function closeEditTimetableModal() {
      document.getElementById('modal-edit-timetable').style.display = 'none';
    }
    document.getElementById('modal-edit-timetable')?.addEventListener('click', (e) => {
      if (e.target.classList.contains('sp-overlay')) {
        closeEditTimetableModal();
      }
    });

    // Reset timetable for selected class/year
    function resetTimetableConfirm() {
      const lop = (ttbClassSel.value || '').toString();
      const nam = (ttbYearSel.value || '').toString();
      const hk = (ttbSemesterSel.value || '1').toString();
      if (!lop || !nam) {
        alert('Vui lòng chọn lớp và năm học để đặt lại.');
        return;
      }
      
      const hkText = hk === '1' ? 'Học kỳ 1' : 'Học kỳ 2';
      showDeleteConfirm(
        `Bạn có chắc chắn muốn xóa toàn bộ thời khóa biểu của lớp "${lop}" - ${hkText} - năm học "${nam}"?`,
        '⚠️ Hành động này không thể hoàn tác! Tất cả thời khóa biểu của lớp này sẽ bị xóa vĩnh viễn.',
        function() {
          document.getElementById('resetMaLop').value = lop;
          document.getElementById('resetNamHoc').value = nam;
          document.getElementById('resetHocKy').value = hk;
          document.getElementById('frm-reset-tkb').submit();
        }
      );
    }
    document.getElementById('form-edit-timetable')?.addEventListener('submit', (e) => {
      // Form sẽ submit bình thường, không cần confirm vì đây là save, không phải delete
      // Nếu muốn có confirm, có thể thêm vào đây
    });
    // Helper to prefill modal fields from existing RAW_TKB data
    function fillModalFromData() {
      const lop = document.getElementById('edit-lop-tkb').value;
      const thu = parseInt(document.getElementById('edit-thu').value, 10);
      const tiet = parseInt(document.getElementById('edit-tiet').value, 10);

      const item = RAW_TKB.find(r => r.MaLop === lop && parseInt(r.Thu,10) === thu && parseInt(r.TietHoc,10) === tiet);
      if (item) {
        document.getElementById('edit-mon-hoc-tkb').value = item.MaMonHoc || '';
        document.getElementById('edit-giao-vien-tkb').value = item.MaGiaoVien || '';
        // optionally set room/note if available
        document.getElementById('edit-phong-hoc').value = item.PhongHoc || '';
        document.getElementById('edit-ghi-chu-tkb').value = item.GhiChu || '';
      } else {
        document.getElementById('edit-mon-hoc-tkb').value = '';
        document.getElementById('edit-giao-vien-tkb').value = '';
        document.getElementById('edit-phong-hoc').value = '';
        document.getElementById('edit-ghi-chu-tkb').value = '';
      }
    }

    document.getElementById('edit-thu')?.addEventListener('change', fillModalFromData);
    document.getElementById('edit-tiet')?.addEventListener('change', fillModalFromData);

    const btnEdit = document.getElementById('btn-edit-tkb');
    if (btnEdit) {
      btnEdit.addEventListener('click', () => {
        document.getElementById('edit-lop-tkb').value = ttbClassSel.value || '12A1';
        document.getElementById('edit-nam-hoc-tkb').value = ttbYearSel.value || '2024-2025';
        document.getElementById('edit-hoc-ky-tkb').value = ttbSemesterSel.value || '1';
        document.getElementById('edit-thu').value = '2';
        document.getElementById('edit-tiet').value = '1';
        document.getElementById('edit-phong-hoc').value = 'A101';

        // Prefill subject/teacher if data exists for defaults
        fillModalFromData();

        openEditTimetableModal();
      });
    }
  </script>
</body>
</html>
