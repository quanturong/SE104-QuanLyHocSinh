<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Quản lý năm học – Quản lí học sinh</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page-student">
  <div class="layout">
    <%- include('../partials/sidebar') %>

    <main class="main">
      <% 
        const role = (user && user.role) ? user.role : ""; 
        const canManage = permissions && permissions.canManageSchoolYear;
      %>

      <!-- Include modals -->
      <%- include('../partials/delete-confirm-modal') %>
      
      <!-- Overlay thêm năm học -->
      <div id="school-year-overlay" class="sp-overlay" style="display:none;">
        <div class="sp-modal">
          <h2 class="sp-title">Thêm năm học mới</h2>
          <form class="sp-form" method="POST" action="/school-year" id="form-add-school-year">
            <div class="sp-field">
              <label>Mã năm học <span style="color: #c33;">*</span></label>
              <input name="MaNamHoc" id="inputMaNamHoc" placeholder="VD: NH2024-2025" required 
                     pattern="^NH\d{4}-\d{4}$" 
                     title="Mã năm học phải có cấu trúc: NHYYYY-YYYY (VD: NH2024-2025)" />
              <small style="color: #666; font-size: 12px; margin-top: 4px; display: block;">
                Định dạng: NH + năm bắt đầu + "-" + năm kết thúc (VD: NH2024-2025)
              </small>
            </div>
            <div class="sp-field">
              <label>Ngày bắt đầu</label>
              <input type="date" name="NgayBatDau" required />
            </div>
            <div class="sp-field">
              <label>Ngày kết thúc</label>
              <input type="date" name="NgayKetThuc" required />
            </div>
            <div class="sp-actions">
              <button type="button" class="sp-btn sp-btn--ghost" id="btn-cancel-add">Đóng</button>
              <button type="submit" class="sp-btn">Lưu</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Overlay sửa năm học -->
      <div id="school-year-edit-overlay" class="sp-overlay" style="display:none;">
        <div class="sp-modal">
          <h2 class="sp-title">Sửa năm học</h2>
          <form class="sp-form" method="POST" action="/school-year/edit" id="form-edit-school-year">
            <input type="hidden" name="OldMaNamHoc" id="editOldMaNamHoc" />
            <div class="sp-field">
              <label>Mã năm học <span style="color: #c33;">*</span></label>
              <input name="MaNamHoc" id="editMaNamHoc" required 
                     pattern="^NH\d{4}-\d{4}$" 
                     title="Mã năm học phải có cấu trúc: NHYYYY-YYYY (VD: NH2024-2025)" />
              <small style="color: #666; font-size: 12px; margin-top: 4px; display: block;">
                Định dạng: NH + năm bắt đầu + "-" + năm kết thúc (VD: NH2024-2025)
              </small>
            </div>
            <div class="sp-field">
              <label>Ngày bắt đầu</label>
              <input type="date" name="NgayBatDau" id="editNgayBatDau" required />
            </div>
            <div class="sp-field">
              <label>Ngày kết thúc</label>
              <input type="date" name="NgayKetThuc" id="editNgayKetThuc" required />
            </div>
            <div class="sp-actions">
              <button type="button" class="sp-btn sp-btn--ghost" id="btn-cancel-edit">Đóng</button>
              <button type="submit" class="sp-btn">Lưu thay đổi</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Overlay sửa học kỳ -->
      <div id="semester-edit-overlay" class="sp-overlay" style="display:none;">
        <div class="sp-modal">
          <h2 class="sp-title">Sửa học kỳ</h2>
          <form class="sp-form" method="POST" action="/school-year/semester/edit" id="form-edit-semester">
            <input type="hidden" name="MaNamHoc" id="editSemesterMaNamHoc" />
            <input type="hidden" name="HocKy" id="editSemesterHocKy" />
            <div class="sp-field">
              <label>Năm học</label>
              <input type="text" id="editSemesterMaNamHocDisplay" readonly style="background: #f5f5f5;" />
            </div>
            <div class="sp-field">
              <label>Học kỳ</label>
              <input type="text" id="editSemesterHocKyDisplay" readonly style="background: #f5f5f5;" />
            </div>
            <div class="sp-field">
              <label>Ngày bắt đầu <span style="color: #c33;">*</span></label>
              <input type="date" name="NgayBatDau" id="editSemesterNgayBatDau" required />
            </div>
            <div class="sp-field">
              <label>Ngày kết thúc <span style="color: #c33;">*</span></label>
              <input type="date" name="NgayKetThuc" id="editSemesterNgayKetThuc" required />
            </div>
            <div class="sp-actions">
              <button type="button" class="sp-btn sp-btn--ghost" id="btn-cancel-edit-semester">Đóng</button>
              <button type="submit" class="sp-btn">Lưu thay đổi</button>
            </div>
          </form>
        </div>
      </div>

      <div class="page-header">
        <h1 class="page-title">Quản lý năm học</h1>
        <p class="page-desc">Khai báo và quản lý các năm học trong hệ thống.</p>
        <% if (typeof error !== 'undefined' && error) { %>
          <div style="background: #fee; color: #c33; padding: 12px 16px; border-radius: 8px; margin-top: 16px; border: 1px solid #fcc;">
            <strong>❌ Lỗi:</strong> <%= error %>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div style="background: #efe; color: #3c3; padding: 12px 16px; border-radius: 8px; margin-top: 16px; border: 1px solid #cfc;">
            <strong>✅ Thành công:</strong> <%= success %>
          </div>
        <% } %>
      </div>

      <section class="card" style="margin-bottom: 16px;">
        <div class="toolbar" style="justify-content: space-between;">
          <div>
            <div style="font-weight: 600; font-size: 16px;">
              <%= (schoolYears && schoolYears.length) ? schoolYears.length : 0 %> năm học
            </div>
          </div>
          <div style="display:flex; gap:8px; align-items:center;">
            <% if (canManage) { %>
              <button class="btn" id="btn-add">+ Thêm năm học</button>
            <% } %>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="table-wrap" style="overflow:auto; max-height:560px;">
          <table class="table" id="tbl-school-years">
            <thead>
              <tr>
                <th style="width:60px;">STT</th>
                <th style="width:200px;">MÃ NĂM HỌC</th>
                <th style="width:180px;">NGÀY BẮT ĐẦU</th>
                <th style="width:180px;">NGÀY KẾT THÚC</th>
                <th style="width:300px;">HỌC KỲ</th>
                <% if (canManage) { %>
                  <th style="width:150px;">THAO TÁC</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% if (schoolYears && schoolYears.length) { %>
                <% schoolYears.forEach(function(sy, index) { 
                  const semesters = typeof semestersMap !== 'undefined' && semestersMap[sy.MaNamHoc] ? semestersMap[sy.MaNamHoc] : [];
                  const hocKy1 = semesters.find(s => s.HocKy === 1);
                  const hocKy2 = semesters.find(s => s.HocKy === 2);
                %>
                  <tr data-manamhoc="<%= sy.MaNamHoc %>" data-ngaybatdau="<%= sy.NgayBatDau %>" data-ngayketthuc="<%= sy.NgayKetThuc %>">
                    <td class="text-center"><%= index + 1 %></td>
                    <td><strong><%= sy.MaNamHoc %></strong></td>
                    <td><%= sy.NgayBatDau ? new Date(sy.NgayBatDau).toLocaleDateString('vi-VN') : '' %></td>
                    <td><%= sy.NgayKetThuc ? new Date(sy.NgayKetThuc).toLocaleDateString('vi-VN') : '' %></td>
                    <td>
                      <div style="display: flex; flex-direction: column; gap: 4px;">
                        <% if (hocKy1) { %>
                          <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-weight: 600;">Học kỳ 1:</span>
                            <span><%= new Date(hocKy1.NgayBatDau).toLocaleDateString('vi-VN') %> - <%= new Date(hocKy1.NgayKetThuc).toLocaleDateString('vi-VN') %></span>
                            <% if (canManage) { %>
                              <button class="btn btn-xs btn-ghost btn-edit-semester" 
                                      data-manamhoc="<%= sy.MaNamHoc %>" 
                                      data-hocky="1"
                                      data-ngaybatdau="<%= hocKy1.NgayBatDau %>"
                                      data-ngayketthuc="<%= hocKy1.NgayKetThuc %>"
                                      style="padding: 2px 6px; font-size: 11px;">Sửa</button>
                            <% } %>
                          </div>
                        <% } %>
                        <% if (hocKy2) { %>
                          <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-weight: 600;">Học kỳ 2:</span>
                            <span><%= new Date(hocKy2.NgayBatDau).toLocaleDateString('vi-VN') %> - <%= new Date(hocKy2.NgayKetThuc).toLocaleDateString('vi-VN') %></span>
                            <% if (canManage) { %>
                              <button class="btn btn-xs btn-ghost btn-edit-semester" 
                                      data-manamhoc="<%= sy.MaNamHoc %>" 
                                      data-hocky="2"
                                      data-ngaybatdau="<%= hocKy2.NgayBatDau %>"
                                      data-ngayketthuc="<%= hocKy2.NgayKetThuc %>"
                                      style="padding: 2px 6px; font-size: 11px;">Sửa</button>
                            <% } %>
                          </div>
                        <% } %>
                        <% if (!hocKy1 && !hocKy2) { %>
                          <span class="muted">Chưa có học kỳ</span>
                        <% } %>
                      </div>
                    </td>
                    <% if (canManage) { %>
                      <td class="text-center">
                        <button class="btn btn-sm btn-edit" type="button">Sửa</button>
                        <button class="btn btn-sm btn-delete" type="button">Xóa</button>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="<%= canManage ? 6 : 5 %>" class="text-center muted">Chưa có năm học trong hệ thống.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <script>
    // Validation mã năm học
    function validateMaNamHoc(maNamHoc) {
      if (!maNamHoc || !maNamHoc.trim()) {
        return { valid: false, message: "Mã năm học không được để trống" };
      }

      const trimmed = maNamHoc.trim();
      const pattern = /^NH\d{4}-\d{4}$/;
      
      if (!pattern.test(trimmed)) {
        return { 
          valid: false, 
          message: "Mã năm học phải có cấu trúc: NHYYYY-YYYY (VD: NH2024-2025)" 
        };
      }

      const match = trimmed.match(/^NH(\d{4})-(\d{4})$/);
      if (!match) {
        return { valid: false, message: "Mã năm học không hợp lệ" };
      }

      const namBatDau = parseInt(match[1], 10);
      const namKetThuc = parseInt(match[2], 10);

      if (namKetThuc !== namBatDau + 1) {
        return { 
          valid: false, 
          message: `Năm kết thúc phải bằng năm bắt đầu + 1. Hiện tại: ${namBatDau}-${namKetThuc}` 
        };
      }

      if (namBatDau < 2000 || namBatDau > 2100) {
        return { 
          valid: false, 
          message: "Năm học phải trong khoảng 2000-2100" 
        };
      }

      return { valid: true, namBatDau, namKetThuc };
    }

    (function () {
      const overlayAdd = document.getElementById('school-year-overlay');
      const btnAdd = document.getElementById('btn-add');
      const btnCancelAdd = document.getElementById('btn-cancel-add');
      const formAdd = document.getElementById('form-add-school-year');
      const inputMaNamHoc = document.getElementById('inputMaNamHoc');

      function openAdd() {
        if (overlayAdd) {
          overlayAdd.style.display = 'grid';
          if (formAdd) formAdd.reset();
          if (inputMaNamHoc) {
            inputMaNamHoc.focus();
            inputMaNamHoc.style.borderColor = '';
          }
        }
      }
      function closeAdd() {
        if (overlayAdd) overlayAdd.style.display = 'none';
      }

      // Validation khi nhập (form add)
      if (inputMaNamHoc) {
        inputMaNamHoc.addEventListener('blur', function() {
          const value = this.value.trim();
          if (value) {
            const validation = validateMaNamHoc(value);
            if (!validation.valid) {
              this.setCustomValidity(validation.message);
              this.style.borderColor = '#ef4444';
            } else {
              this.setCustomValidity('');
              this.style.borderColor = '';
            }
          }
        });

        inputMaNamHoc.addEventListener('input', function() {
          this.setCustomValidity('');
          this.style.borderColor = '';
        });
      }

      // Validation khi submit (form add)
      if (formAdd) {
        formAdd.addEventListener('submit', function(e) {
          const maNamHoc = inputMaNamHoc?.value.trim();
          if (maNamHoc) {
            const validation = validateMaNamHoc(maNamHoc);
            if (!validation.valid) {
              e.preventDefault();
              alert('Lỗi: ' + validation.message);
              inputMaNamHoc?.focus();
              return false;
            }

            // Kiểm tra năm học có khớp với ngày không
            const ngayBatDauInput = formAdd.querySelector('input[name="NgayBatDau"]');
            const ngayKetThucInput = formAdd.querySelector('input[name="NgayKetThuc"]');
            
            if (ngayBatDauInput && ngayKetThucInput && ngayBatDauInput.value && ngayKetThucInput.value) {
              const ngayBatDau = new Date(ngayBatDauInput.value);
              const ngayKetThuc = new Date(ngayKetThucInput.value);
              const namBatDauFromDate = ngayBatDau.getFullYear();
              const namKetThucFromDate = ngayKetThuc.getFullYear();

              if (namBatDauFromDate !== validation.namBatDau) {
                e.preventDefault();
                alert(`Lỗi: Năm bắt đầu trong mã năm học (${validation.namBatDau}) không khớp với ngày bắt đầu (${namBatDauFromDate})`);
                return false;
              }

              if (namKetThucFromDate !== validation.namKetThuc) {
                e.preventDefault();
                alert(`Lỗi: Năm kết thúc trong mã năm học (${validation.namKetThuc}) không khớp với ngày kết thúc (${namKetThucFromDate})`);
                return false;
              }
            }
          }
        });
      }

      btnAdd && btnAdd.addEventListener('click', openAdd);
      btnCancelAdd && btnCancelAdd.addEventListener('click', closeAdd);
      overlayAdd && overlayAdd.addEventListener('click', e => {
        if (e.target === overlayAdd) closeAdd();
      });
    })();

    (function () {
      const overlayEdit = document.getElementById('school-year-edit-overlay');
      const btnCancelEdit = document.getElementById('btn-cancel-edit');

      function openEdit() {
        if (overlayEdit) overlayEdit.style.display = 'grid';
      }
      function closeEdit() {
        if (overlayEdit) overlayEdit.style.display = 'none';
      }
      btnCancelEdit && btnCancelEdit.addEventListener('click', closeEdit);
      overlayEdit && overlayEdit.addEventListener('click', e => {
        if (e.target === overlayEdit) closeEdit();
      });

      // Xử lý sửa học kỳ
      document.querySelectorAll('.btn-edit-semester').forEach(btn => {
        btn.addEventListener('click', function() {
          const maNamHoc = this.getAttribute('data-manamhoc');
          const hocKy = this.getAttribute('data-hocky');
          const ngayBatDau = this.getAttribute('data-ngaybatdau');
          const ngayKetThuc = this.getAttribute('data-ngayketthuc');

          document.getElementById('editSemesterMaNamHoc').value = maNamHoc;
          document.getElementById('editSemesterMaNamHocDisplay').value = maNamHoc;
          document.getElementById('editSemesterHocKy').value = hocKy;
          document.getElementById('editSemesterHocKyDisplay').value = `Học kỳ ${hocKy}`;
          document.getElementById('editSemesterNgayBatDau').value = ngayBatDau;
          document.getElementById('editSemesterNgayKetThuc').value = ngayKetThuc;

          const overlaySemester = document.getElementById('semester-edit-overlay');
          if (overlaySemester) overlaySemester.style.display = 'grid';
        });
      });

      const formEdit = document.getElementById('form-edit-school-year');
      const inputEditMaNamHoc = document.getElementById('editMaNamHoc');

      // Validation khi nhập (form edit)
      if (inputEditMaNamHoc) {
        inputEditMaNamHoc.addEventListener('blur', function() {
          const value = this.value.trim();
          if (value) {
            const validation = validateMaNamHoc(value);
            if (!validation.valid) {
              this.setCustomValidity(validation.message);
              this.style.borderColor = '#ef4444';
            } else {
              this.setCustomValidity('');
              this.style.borderColor = '';
            }
          }
        });

        inputEditMaNamHoc.addEventListener('input', function() {
          this.setCustomValidity('');
          this.style.borderColor = '';
        });
      }

      // Validation khi submit (form edit)
      if (formEdit) {
        formEdit.addEventListener('submit', function(e) {
          const maNamHoc = inputEditMaNamHoc?.value.trim();
          if (maNamHoc) {
            const validation = validateMaNamHoc(maNamHoc);
            if (!validation.valid) {
              e.preventDefault();
              alert('Lỗi: ' + validation.message);
              inputEditMaNamHoc?.focus();
              return false;
            }

            // Kiểm tra năm học có khớp với ngày không
            const ngayBatDau = new Date(formEdit.querySelector('input[name="NgayBatDau"]').value);
            const ngayKetThuc = new Date(formEdit.querySelector('input[name="NgayKetThuc"]').value);
            const namBatDauFromDate = ngayBatDau.getFullYear();
            const namKetThucFromDate = ngayKetThuc.getFullYear();

            if (namBatDauFromDate !== validation.namBatDau) {
              e.preventDefault();
              alert(`Lỗi: Năm bắt đầu trong mã năm học (${validation.namBatDau}) không khớp với ngày bắt đầu (${namBatDauFromDate})`);
              return false;
            }

            if (namKetThucFromDate !== validation.namKetThuc) {
              e.preventDefault();
              alert(`Lỗi: Năm kết thúc trong mã năm học (${validation.namKetThuc}) không khớp với ngày kết thúc (${namKetThucFromDate})`);
              return false;
            }
          }
        });
      }

      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', function () {
          const tr = this.closest('tr');
          if (!tr) return;
          const maNamHoc = tr.getAttribute('data-manamhoc') || '';
          const ngayBatDau = tr.getAttribute('data-ngaybatdau') || '';
          const ngayKetThuc = tr.getAttribute('data-ngayketthuc') || '';
          document.getElementById('editOldMaNamHoc').value = maNamHoc;
          document.getElementById('editMaNamHoc').value = maNamHoc;
          document.getElementById('editNgayBatDau').value = ngayBatDau;
          document.getElementById('editNgayKetThuc').value = ngayKetThuc;
          openEdit();
        });
      });

      // Xử lý sửa học kỳ
      document.querySelectorAll('.btn-edit-semester').forEach(btn => {
        btn.addEventListener('click', function() {
          const maNamHoc = this.getAttribute('data-manamhoc');
          const hocKy = this.getAttribute('data-hocky');
          const ngayBatDau = this.getAttribute('data-ngaybatdau');
          const ngayKetThuc = this.getAttribute('data-ngayketthuc');

          document.getElementById('editSemesterMaNamHoc').value = maNamHoc;
          document.getElementById('editSemesterMaNamHocDisplay').value = maNamHoc;
          document.getElementById('editSemesterHocKy').value = hocKy;
          document.getElementById('editSemesterHocKyDisplay').value = `Học kỳ ${hocKy}`;
          document.getElementById('editSemesterNgayBatDau').value = ngayBatDau;
          document.getElementById('editSemesterNgayKetThuc').value = ngayKetThuc;

          const overlaySemester = document.getElementById('semester-edit-overlay');
          if (overlaySemester) overlaySemester.style.display = 'grid';
        });
      });
    })();

    (function () {
      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', function () {
          const tr = this.closest('tr');
          if (!tr) return;
          const maNamHoc = tr.getAttribute('data-manamhoc') || '';
          showDeleteConfirm(
            `Bạn có chắc chắn muốn xóa năm học "${maNamHoc}"?`,
            '⚠️ Hành động này không thể hoàn tác! Tất cả dữ liệu liên quan đến năm học này có thể bị ảnh hưởng.',
            function() {
              const form = document.createElement('form');
              form.method = 'POST';
              form.action = '/school-year/delete';
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'MaNamHoc';
              input.value = maNamHoc;
              form.appendChild(input);
              document.body.appendChild(form);
              form.submit();
            }
          );
        });
      });
    })();

    // Xử lý modal sửa học kỳ
    (function() {
      const overlaySemester = document.getElementById('semester-edit-overlay');
      const btnCancelEditSemester = document.getElementById('btn-cancel-edit-semester');

      function closeEditSemester() {
        if (overlaySemester) overlaySemester.style.display = 'none';
      }

      btnCancelEditSemester && btnCancelEditSemester.addEventListener('click', closeEditSemester);
      overlaySemester && overlaySemester.addEventListener('click', e => {
        if (e.target === overlaySemester) closeEditSemester();
      });
    })();
  </script>
</body>
</html>

