<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Tra cứu hồ sơ học sinh</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page-student">
  <div class="layout">
    <%- include('../partials/sidebar') %>

    <main class="main">
      <div class="page-header">
        <h1 class="page-title">Tra cứu</h1>
        <p class="page-desc">Tra cứu thông tin học sinh hoặc giáo viên trong hệ thống.</p>
      </div>

      <!-- Tabs -->
      <section class="card" style="margin-bottom:16px;">
        <div style="display:flex; gap:8px; border-bottom:2px solid #e2e8f0; margin-bottom:16px;">
          <button class="tab-btn active" data-tab="student" style="padding:10px 20px; border:none; background:transparent; cursor:pointer; border-bottom:2px solid transparent; font-size:14px; font-weight:500; color:#64748b; transition:all 0.2s;">👨‍🎓 Học sinh</button>
          <button class="tab-btn" data-tab="teacher" style="padding:10px 20px; border:none; background:transparent; cursor:pointer; border-bottom:2px solid transparent; font-size:14px; font-weight:500; color:#64748b; transition:all 0.2s;">👨‍🏫 Giáo viên</button>
        </div>
        <style>
          .tab-btn.active { color: #0ea5e9; border-bottom-color: #0ea5e9; }
          .tab-btn:hover { color: #0ea5e9; }
        </style>

        <!-- Tab Học sinh -->
        <div id="tab-student" class="tab-content">
          <div class="toolbar">
            <input class="input" id="q-student" placeholder="Nhập MSHS hoặc họ tên học sinh..." style="min-width:280px;" />
            <button class="btn" id="btn-search-student">🔎 Tra cứu</button>
            <button class="btn btn-export" id="btn-print-student">🖨️ In hồ sơ</button>
            <span class="muted" id="hint-student"></span>
          </div>
        </div>

        <!-- Tab Giáo viên -->
        <div id="tab-teacher" class="tab-content" style="display:none;">
          <div class="toolbar">
            <input class="input" id="q-teacher" placeholder="Nhập mã giáo viên hoặc họ tên..." style="min-width:280px;" />
            <button class="btn" id="btn-search-teacher">🔎 Tra cứu</button>
            <button class="btn btn-export" id="btn-print-teacher">🖨️ In hồ sơ</button>
            <span class="muted" id="hint-teacher"></span>
          </div>
        </div>
      </section>

      <!-- Kết quả tra cứu học sinh -->
      <div id="result-student" style="display:none;">
        <section class="card" style="margin-bottom:16px;">
          <div class="profile">
            <div class="avatar" id="pf-avatar">HS</div>
            <div>
              <h2 class="p-name" id="pf-name">—</h2>
              <p class="p-sub" id="pf-sub">MSHS: — · Lớp hiện tại: —</p>
              <div style="margin-top:6px;">
                <span class="pill" id="pf-dob">Ngày sinh: —</span>
                <span class="pill" id="pf-gender">Giới tính: —</span>
                <span class="pill" id="pf-email">Email: —</span>
                <span class="pill" id="pf-address">Địa chỉ: —</span>
              </div>
            </div>
          </div>
        </section>

        <section class="grid cols-2" style="margin-bottom:16px;">
          <div class="card stat-mini">
            <div class="stat-mini-label">Điểm TB môn cao nhất</div>
            <div class="stat-mini-value" id="st-best">—</div>
          </div>
          <div class="card stat-mini">
            <div class="stat-mini-label">Điểm TB môn thấp nhất</div>
            <div class="stat-mini-value" id="st-worst">—</div>
          </div>
        </section>

        <section class="card" style="margin-bottom:16px;">
          <div class="page-header" style="margin-bottom:12px;">
            <h2 class="page-title" style="font-size:18px;">Bảng điểm chi tiết</h2>
            <p class="page-desc">Các cột được lấy trực tiếp từ bảng BangDiemMonHoc trong database.</p>
          </div>
          <div class="report-filter-grid" style="margin-bottom:16px;">
            <div class="class-info-item">
              <label class="class-label">Năm học</label>
              <select class="select class-select" id="filter-year">
                <option value="">-- Tất cả năm học --</option>
              </select>
            </div>
            <div class="class-info-item">
              <label class="class-label">Học kỳ</label>
              <select class="select class-select" id="filter-semester">
                <option value="">-- Tất cả học kỳ --</option>
                <option value="1">Học kỳ I</option>
                <option value="2">Học kỳ II</option>
              </select>
            </div>
          </div>
          <div class="table-wrap" style="overflow:auto; max-height:520px;">
            <table class="table" id="tbl-scores">
              <thead>
                <tr>
                  <th style="width:60px;">STT</th>
                  <th style="width:120px;">Năm học</th>
                  <th style="width:80px;">Học kỳ</th>
                  <th style="width:220px;">Môn học</th>
                  <th style="width:120px;">Điểm 15'</th>
                  <th style="width:120px;">Điểm 1 tiết</th>
                  <th style="width:120px;">Điểm TB môn</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td colspan="7" class="text-center muted">
                    Chưa có dữ liệu điểm cho học sinh này.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="card" style="margin-bottom:16px;">
          <div class="page-header" style="margin-bottom:12px;">
            <h2 class="page-title" style="font-size:18px;">Lịch sử điểm danh</h2>
            <p class="page-desc">Danh sách các lần điểm danh cho học sinh.</p>
          </div>
          <div class="table-wrap" style="overflow:auto; max-height:320px;">
            <table class="table" id="tbl-attendance">
              <thead>
                <tr>
                  <th style="width:60px;">STT</th>
                  <th style="width:120px;">Ngày</th>
                  <th style="width:100px;">Lớp</th>
                  <th style="width:140px;">Trạng thái</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td colspan="4" class="text-center muted">
                    Chưa có dữ liệu điểm danh cho học sinh này.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <section class="card" id="no-data-student" style="display:none;">
        <p class="muted">Không tìm thấy học sinh phù hợp. Hãy kiểm tra lại MSHS/Họ tên.</p>
      </section>

      <!-- Kết quả tra cứu giáo viên -->
      <div id="result-teacher" style="display:none;">
        <section class="card" style="margin-bottom:16px;">
          <div class="profile">
            <div class="avatar" id="pf-teacher-avatar">GV</div>
            <div>
              <h2 class="p-name" id="pf-teacher-name">—</h2>
              <p class="p-sub" id="pf-teacher-sub">Mã GV: — · Bộ môn: —</p>
              <div style="margin-top:6px;">
                <span class="pill" id="pf-teacher-dob">Ngày sinh: —</span>
                <span class="pill" id="pf-teacher-gender">Giới tính: —</span>
                <span class="pill" id="pf-teacher-email">Email: —</span>
                <span class="pill" id="pf-teacher-address">Địa chỉ: —</span>
              </div>
            </div>
          </div>
        </section>

        <section class="card" style="margin-bottom:16px;">
          <div class="page-header" style="margin-bottom:12px;">
            <h2 class="page-title" style="font-size:18px;">Lớp đang giảng dạy</h2>
          </div>
          <div class="table-wrap" style="overflow:auto; max-height:320px;">
            <table class="table" id="tbl-teacher-classes">
              <thead>
                <tr>
                  <th style="width:60px;">STT</th>
                  <th style="width:120px;">Lớp</th>
                  <th style="width:220px;">Môn học</th>
                  <th style="width:140px;">Thứ</th>
                  <th style="width:100px;">Tiết</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td colspan="5" class="text-center muted">Chưa có dữ liệu.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <section class="card" id="no-data-teacher" style="display:none;">
        <p class="muted">Không tìm thấy giáo viên phù hợp. Hãy kiểm tra lại mã hoặc họ tên.</p>
      </section>
    </main>
  </div>

  <script>
    const STUDENTS = <%- JSON.stringify(typeof students !== "undefined" ? students : []) %>;
    const SCORES = <%- JSON.stringify(typeof scores !== "undefined" ? scores : []) %>;
    const ATTENDANCES = <%- JSON.stringify(typeof attendances !== "undefined" ? attendances : []) %>;
    const TEACHERS = <%- JSON.stringify(typeof teachers !== "undefined" ? teachers : []) %>;
    const TIMETABLES = <%- JSON.stringify(typeof timetables !== "undefined" ? timetables : []) %>;

    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const tab = this.getAttribute('data-tab');
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
        document.getElementById(`tab-${tab}`).style.display = 'block';
        
        // Reset results
        document.getElementById('result-student').style.display = 'none';
        document.getElementById('result-teacher').style.display = 'none';
        document.getElementById('no-data-student').style.display = 'none';
        document.getElementById('no-data-teacher').style.display = 'none';
      });
    });


    function round1(x){ return Math.round(x * 10) / 10; }

    function scoreClass(v){
      if (v >= 8) return 'score-excellent';
      if (v >= 6.5) return 'score-good';
      if (v >= 5) return 'score-average';
      return 'score-weak';
    }

    function fillProfile(stu){
      const parts = (stu.HoTen || '').trim().split(/\s+/);
      const initials = parts.slice(-2).map(p => p[0]).join('').toUpperCase() || 'HS';
      document.getElementById('pf-avatar').textContent = initials;

      document.getElementById('pf-name').textContent = stu.HoTen || '—';
      document.getElementById('pf-sub').textContent  = `MSHS: ${stu.MaHocSinh} · Lớp hiện tại: ${stu.MaLop || '—'}`;

      let dobText = '—';
      if (stu.NgaySinh) {
        const d = new Date(stu.NgaySinh);
        if (!isNaN(d.getTime())) {
          dobText = d.toLocaleDateString('vi-VN');
        } else {
          dobText = stu.NgaySinh;
        }
      }

      document.getElementById('pf-dob').textContent     = `Ngày sinh: ${dobText}`;
      document.getElementById('pf-gender').textContent  = `Giới tính: ${stu.GioiTinh || '—'}`;
      document.getElementById('pf-email').textContent   = `Email: ${stu.Email || '—'}`;
      document.getElementById('pf-address').textContent = `Địa chỉ: ${stu.DiaChi || '—'}`;
    }

    function fillStats(stu){
      const stuId = stu.MaHocSinh;

      const stuScores = SCORES.filter(r => r.MaHocSinh === stuId);
      const stuAtt    = ATTENDANCES.filter(r => r.MaHocSinh === stuId);

      const tbList = stuScores
        .map(r => r.DiemTBMon)
        .filter(v => typeof v === 'number' && !isNaN(v));

      if (tbList.length) {
        const best = Math.max(...tbList);
        const worst = Math.min(...tbList);
        document.getElementById('st-best').textContent  = round1(best).toFixed(1);
        document.getElementById('st-worst').textContent = round1(worst).toFixed(1);
      } else {
        document.getElementById('st-best').textContent  = '—';
        document.getElementById('st-worst').textContent = '—';
      }

    }

    function updateYearDropdown(stu){
      const yearSelect = document.getElementById('filter-year');
      const stuId = stu.MaHocSinh;
      const stuScores = SCORES.filter(r => r.MaHocSinh === stuId);
      
      const uniqueYears = [...new Set(stuScores.map(r => r.NamHoc).filter(y => y))].sort().reverse();
      
      yearSelect.innerHTML = '<option value="">-- Tất cả năm học --</option>';
      
      if (uniqueYears.length > 0) {
        uniqueYears.forEach(year => {
          const option = document.createElement('option');
          option.value = year;
          option.textContent = year;
          yearSelect.appendChild(option);
        });
      }
    }

    function renderScores(stu){
      const tbody = document.querySelector('#tbl-scores tbody');
      const stuId = stu.MaHocSinh;
      const filterYear = document.getElementById('filter-year').value;
      const filterSemester = document.getElementById('filter-semester').value;
      
      let stuScores = SCORES.filter(r => r.MaHocSinh === stuId);
      
      if (filterYear) {
        stuScores = stuScores.filter(r => r.NamHoc === filterYear);
      }
      
      if (filterSemester) {
        stuScores = stuScores.filter(r => String(r.HocKy) === filterSemester);
      }

      if (!stuScores.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="text-center muted">
              Chưa có dữ liệu điểm cho học sinh này.
            </td>
          </tr>`;
        return;
      }

      const rows = stuScores.map((r, index) => {
        const tb = typeof r.DiemTBMon === 'number' ? r.DiemTBMon : null;
        const tbText = tb != null ? tb.toFixed(1) : '';
        const cls = tb != null ? scoreClass(tb) : '';

        return `
          <tr>
            <td class="text-center">${index + 1}</td>
            <td>${r.NamHoc || ''}</td>
            <td class="text-center">${r.HocKy != null ? r.HocKy : ''}</td>
            <td>${r.TenMonHoc || r.MaMonHoc || ''}</td>
            <td class="text-center">${r.Diem15Phut != null ? r.Diem15Phut : ''}</td>
            <td class="text-center">${r.Diem1Tiet != null ? r.Diem1Tiet : ''}</td>
            <td class="score-cell">
              <span class="score ${cls}">${tbText}</span>
            </td>
          </tr>
        `;
      }).join("");

      tbody.innerHTML = rows;
    }
    
    let currentStudent = null;
    
    document.getElementById('filter-year').addEventListener('change', function() {
      if (currentStudent) {
        renderScores(currentStudent);
      }
    });
    
    document.getElementById('filter-semester').addEventListener('change', function() {
      if (currentStudent) {
        renderScores(currentStudent);
      }
    });

    function renderAttendance(stu){
      const tbody = document.querySelector('#tbl-attendance tbody');
      const stuId = stu.MaHocSinh;
      const stuAtt = ATTENDANCES.filter(r => r.MaHocSinh === stuId);

      if (!stuAtt.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="4" class="text-center muted">
              Chưa có dữ liệu điểm danh cho học sinh này.
            </td>
          </tr>`;
        return;
      }

      const rows = stuAtt.map((r, index) => {
        let dateText = r.NgayDiemDanh || '';
        const d = new Date(r.NgayDiemDanh);
        if (!isNaN(d.getTime())) {
          dateText = d.toLocaleDateString('vi-VN');
        }

        return `
          <tr>
            <td class="text-center">${index + 1}</td>
            <td>${dateText}</td>
            <td>${r.MaLop || ''}</td>
            <td>${r.TrangThai || ''}</td>
          </tr>`;
      }).join("");

      tbody.innerHTML = rows;
    }

    // Tra cứu học sinh
    function doSearchStudent(){
      const qInput = document.getElementById('q-student');
      const hint   = document.getElementById('hint-student');
      const query  = (qInput.value || '').trim().toLowerCase();

      if (!query) {
        hint.textContent = "Vui lòng nhập MSHS hoặc một phần họ tên.";
        document.getElementById('no-data-student').style.display = 'block';
        document.getElementById('result-student').style.display  = 'none';
        return;
      }

      const stu = STUDENTS.find(st =>
        String(st.MaHocSinh).toLowerCase() === query ||
        (st.HoTen || '').toLowerCase().includes(query)
      );

      if (!stu) {
        hint.textContent = "Không tìm thấy học sinh.";
        document.getElementById('no-data-student').style.display = 'block';
        document.getElementById('result-student').style.display  = 'none';
        return;
      }

      hint.textContent = "";
      document.getElementById('no-data-student').style.display = 'none';
      document.getElementById('result-student').style.display  = 'block';

      currentStudent = stu;
      fillProfile(stu);
      fillStats(stu);
      updateYearDropdown(stu);
      document.getElementById('filter-year').value = '';
      document.getElementById('filter-semester').value = '';
      renderScores(stu);
      renderAttendance(stu);
    }

    // Tra cứu giáo viên
    function fillTeacherProfile(teacher){
      const parts = (teacher.HoTen || '').trim().split(/\s+/);
      const initials = parts.slice(-2).map(p => p[0]).join('').toUpperCase() || 'GV';
      document.getElementById('pf-teacher-avatar').textContent = initials;

      document.getElementById('pf-teacher-name').textContent = teacher.HoTen || '—';
      const monHocText = teacher.TenMonHoc || teacher.MaMonGiangDay || '—';
      document.getElementById('pf-teacher-sub').textContent = `Mã GV: ${teacher.MaGiaoVien} · Bộ môn: ${monHocText}`;

      let dobText = '—';
      if (teacher.NgaySinh) {
        const d = new Date(teacher.NgaySinh);
        if (!isNaN(d.getTime())) {
          dobText = d.toLocaleDateString('vi-VN');
        } else {
          dobText = teacher.NgaySinh;
        }
      }

      document.getElementById('pf-teacher-dob').textContent = `Ngày sinh: ${dobText}`;
      document.getElementById('pf-teacher-gender').textContent = `Giới tính: ${teacher.GioiTinh || '—'}`;
      document.getElementById('pf-teacher-email').textContent = `Email: ${teacher.Email || '—'}`;
      document.getElementById('pf-teacher-address').textContent = `Địa chỉ: ${teacher.DiaChi || '—'}`;
    }

    function renderTeacherClasses(teacher){
      const tbody = document.querySelector('#tbl-teacher-classes tbody');
      const teacherId = teacher.MaGiaoVien;
      const classes = TIMETABLES.filter(t => t.MaGiaoVien == teacherId);

      if (!classes.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center muted">
              Giáo viên này chưa được phân công giảng dạy lớp nào.
            </td>
          </tr>`;
        return;
      }

      const rows = classes.map((c, index) => {
        return `
          <tr>
            <td class="text-center">${index + 1}</td>
            <td>${c.MaLop || ''}</td>
            <td>${c.TenMonHoc || c.MaMonHoc || ''}</td>
            <td>Thứ ${c.Thu || ''}</td>
            <td class="text-center">${c.TietHoc || ''}</td>
          </tr>
        `;
      }).join("");

      tbody.innerHTML = rows;
    }

    function doSearchTeacher(){
      const qInput = document.getElementById('q-teacher');
      const hint   = document.getElementById('hint-teacher');
      const query  = (qInput.value || '').trim().toLowerCase();

      if (!query) {
        hint.textContent = "Vui lòng nhập mã giáo viên hoặc một phần họ tên.";
        document.getElementById('no-data-teacher').style.display = 'block';
        document.getElementById('result-teacher').style.display  = 'none';
        return;
      }

      const teacher = TEACHERS.find(t =>
        String(t.MaGiaoVien).toLowerCase() === query ||
        (t.HoTen || '').toLowerCase().includes(query) ||
        (t.Email || '').toLowerCase().includes(query)
      );

      if (!teacher) {
        hint.textContent = "Không tìm thấy giáo viên.";
        document.getElementById('no-data-teacher').style.display = 'block';
        document.getElementById('result-teacher').style.display  = 'none';
        return;
      }

      hint.textContent = "";
      document.getElementById('no-data-teacher').style.display = 'none';
      document.getElementById('result-teacher').style.display  = 'block';

      fillTeacherProfile(teacher);
      renderTeacherClasses(teacher);
    }

    document.getElementById('btn-search-student').addEventListener('click', doSearchStudent);
    document.getElementById('q-student').addEventListener('keydown', e => {
      if (e.key === 'Enter') doSearchStudent();
    });
    document.getElementById('btn-print-student').addEventListener('click', () => {
      window.print();
    });

    document.getElementById('btn-search-teacher').addEventListener('click', doSearchTeacher);
    document.getElementById('q-teacher').addEventListener('keydown', e => {
      if (e.key === 'Enter') doSearchTeacher();
    });
    document.getElementById('btn-print-teacher').addEventListener('click', () => {
      window.print();
    });
  </script>
</body>
</html>
