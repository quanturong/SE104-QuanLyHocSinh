<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Thông tin giáo viên</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page-student">
  <div class="layout">
    <%
      const canManageTeachers = permissions && permissions.canManageTeachers;
    %>
    <%- include('../partials/sidebar') %>

    <main class="main">
      <div class="page-header">
        <h1 class="page-title">Thông tin giáo viên</h1>
        <p class="page-desc">
          Danh sách giáo viên toàn trường: bộ môn giảng dạy, liên hệ, chủ nhiệm lớp…
        </p>
      </div>

      <!-- Include notification modal -->
      <%- include('../partials/notification-modal') %>
      <%- include('../partials/delete-confirm-modal') %>
      <section class="card" style="margin-bottom:16px;">
        <div class="toolbar" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
          <div style="min-width:200px; flex:0 0 auto; display:flex; flex-direction:column;">
            <label class="class-label" style="display:block; font-weight:600; font-size:13px; color:#334155; margin-bottom:6px; line-height:1.2;">BỘ MÔN</label>
            <select id="filter-subject" class="select class-select" style="width:100%; height:44px; padding:0 14px;">
              <option value="">Tất cả bộ môn</option>
              <% if (subjects && subjects.length) { %>
                <% subjects.forEach(function(s) { %>
                  <option value="<%= (s.TenMonHoc || '').toLowerCase() %>">
                    <%= s.TenMonHoc %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div style="flex:1; min-width:260px; display:flex; flex-direction:column;">
            <label style="display:block; font-weight:600; font-size:13px; color:#334155; margin-bottom:6px; line-height:1.2; visibility:hidden;">Tìm kiếm</label>
            <input
              id="search-teacher"
              class="input"
              placeholder="Tìm theo họ tên / email / địa chỉ…"
              style="width:100%; height:44px; padding:0 14px;"
            >
          </div>

          <% if (canManageTeachers) { %>
            <div style="display:flex; flex-direction:column;">
              <label style="display:block; font-weight:600; font-size:13px; color:#334155; margin-bottom:6px; line-height:1.2; visibility:hidden;">Thêm</label>
              <button class="btn" id="btn-add" title="Thêm giáo viên" style="height:44px; padding:0 20px; white-space:nowrap; min-width:100px;">➕ Thêm</button>
            </div>
          <% } %>

          <div style="display:flex; flex-direction:column;">
            <label style="display:block; font-weight:600; font-size:13px; color:#334155; margin-bottom:6px; line-height:1.2; visibility:hidden;">Xuất</label>
            <button class="btn btn-export" id="btn-export" title="Xuất danh sách" style="height:44px; padding:0 20px; white-space:nowrap; min-width:100px;">⬇️ Xuất</button>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="table-wrap" style="overflow:auto; max-height:560px; border-radius:12px;">
          <table class="table" id="tbl-teachers" style="width:100%; table-layout:auto;">
            <thead>
              <tr>
                <th style="width:60px; text-align:center;">STT</th>
                <th style="width:200px;">Họ tên</th>
                <th style="width:150px;">Bộ môn</th>
                <th style="width:200px;">Email</th>
                <th style="width:220px;">Địa chỉ</th>
                <th style="width:180px; text-align:center;">Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% if (teachers && teachers.length) { %>
                <% teachers.forEach(function(t, index) { %>
                  <tr
                    data-name="<%= (t.HoTen || '').toLowerCase() %>"
                    data-subject="<%= ((t.MonHocs && t.MonHocs.length > 0) ? t.MonHocs.map(m => m.TenMonHoc || m.MaMonHoc).join(', ') : (t.TenMonHoc || t.MaMonGiangDay || '')).toLowerCase() %>"
                    data-contact="<%= (t.Email || '').toLowerCase() %>"
                    data-address="<%= (t.DiaChi || '').toLowerCase() %>"
                  >
                    <td class="text-center"><%= index + 1 %></td>
                    <td><strong><%= t.HoTen || '' %></strong></td>
                    <td>
                      <% if (t.MonHocs && t.MonHocs.length > 0) { %>
                        <%= t.MonHocs.map(m => m.TenMonHoc || m.MaMonHoc).join(', ') %>
                      <% } else { %>
                        <%= t.TenMonHoc || t.MaMonGiangDay || '' %>
                      <% } %>
                    </td>
                    <td><%= t.Email || '' %></td>
                    <td><%= t.DiaChi || '' %></td>
                    <td style="text-align:center; white-space:nowrap;">
                      <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
                        <button class="btn btn-sm btn-view" type="button" data-view="<%= t.MaGiaoVien %>">
                          Xem
                        </button>
                        <% if (canManageTeachers) { %>
                          <button
                            class="btn btn-sm btn-edit"
                            type="button"
                            data-edit="<%= t.MaGiaoVien %>"
                            data-magv="<%= t.MaGiaoVien %>"
                            data-hoten="<%= t.HoTen || '' %>"
                            data-gioitinh="<%= t.GioiTinh || '' %>"
                            data-ngaysinh="<%= t.NgaySinh || '' %>"
                            data-diachi="<%= t.DiaChi || '' %>"
                            data-email="<%= t.Email || '' %>"
                            data-mamon="<%= t.MaMonGiangDay || '' %>"
                            data-monhocs="<%= t.MonHocs ? JSON.stringify(t.MonHocs.map(m => m.MaMonHoc)) : '[]' %>"
                          >
                            Sửa
                          </button>
                          <button
                            class="btn btn-sm btn-delete"
                            type="button"
                            data-delete="<%= t.MaGiaoVien %>"
                            data-hoten="<%= t.HoTen || '' %>"
                          >
                            Xóa
                          </button>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" style="text-align:center; padding:40px 20px; color:#64748b;">
                    <div style="font-size:15px;">Chưa có giáo viên trong hệ thống.</div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="pagination" style="margin-top:16px; display:flex; justify-content:center; align-items:center; gap:12px;">
          <button class="btn-page" disabled>‹</button>
          <span class="page-info">Trang <strong>1</strong> / <strong>1</strong></span>
          <button class="btn-page" disabled>›</button>
        </div>
      </section>
      <div class="sp-overlay" id="modal-edit-teacher" style="display:none;">
        <div class="sp-modal">
          <h2 class="sp-title">Sửa thông tin giáo viên</h2>
          
          <form class="sp-form" id="form-edit-teacher" method="POST" action="/teacher/edit">
            <input type="hidden" name="MaGiaoVien" id="edit-gv-magv-hidden" />
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
              <div class="sp-field">
                <label>Mã giáo viên</label>
                <input
                  type="text"
                  id="edit-gv-magv"
                  readonly
                  style="background:#f1f5f9; cursor:not-allowed;"
                />
              </div>

              <div class="sp-field">
                <label>Bộ môn giảng dạy <span style="color:#64748b; font-size:12px;">(có thể chọn nhiều)</span></label>
                <div id="edit-gv-mon-container" style="max-height:200px; overflow-y:auto; border:1px solid #cbd5e1; border-radius:6px; padding:8px; background:#fff;">
                  <% if (subjects && subjects.length) { %>
                    <% subjects.forEach(function(sub){ %>
                      <label style="display:flex; align-items:center; gap:8px; padding:6px; cursor:pointer; border-radius:4px; transition:background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                        <input type="checkbox" name="MonHocs" value="<%= sub.MaMonHoc %>" class="edit-gv-mon-checkbox" style="cursor:pointer;" />
                        <span><%= sub.TenMonHoc %> (<%= sub.MaMonHoc %>)</span>
                      </label>
                    <% }) %>
                  <% } else { %>
                    <p style="color:#94a3b8; padding:8px;">Chưa có môn học</p>
                  <% } %>
                </div>
                <input type="hidden" name="MaMonGiangDay" id="edit-gv-mon" />
              </div>
            </div>

            <div class="sp-field">
              <label>Họ tên</label>
              <input type="text" name="HoTen" id="edit-gv-hoten" required />
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
              <div class="sp-field">
                <label>Giới tính</label>
                <select name="GioiTinh" id="edit-gv-gioitinh">
                  <option value="">-- Chọn --</option>
                  <option value="Nam">Nam</option>
                  <option value="Nữ">Nữ</option>
                  <option value="Khác">Khác</option>
                </select>
              </div>

              <div class="sp-field">
                <label>Ngày sinh</label>
                <input type="date" name="NgaySinh" id="edit-gv-ngaysinh" />
              </div>
            </div>

            <div class="sp-field">
              <label>Email</label>
              <input type="email" name="Email" id="edit-gv-email" required />
            </div>

            <div class="sp-field">
              <label>Địa chỉ</label>
              <input type="text" name="DiaChi" id="edit-gv-diachi" />
            </div>

            <div class="sp-actions">
              <button
                type="button"
                class="sp-btn sp-btn--ghost"
                onclick="closeEditTeacherModal()"
              >
                Đóng
              </button>
              <button type="submit" class="sp-btn">
                Lưu thay đổi
              </button>
            </div>
          </form>
        </div>
      </div>
      <div class="sp-overlay" id="modal-view-teacher" style="display:none;">
        <div class="sp-modal" style="max-width:700px;">
          <h2 class="sp-title">Thông tin chi tiết giáo viên</h2>
          
          <div class="sp-form">
            <div style="display:flex; align-items:center; gap:16px; padding:20px; background:#f8fafc; border-radius:8px; margin-bottom:20px;">
              <div style="width:80px; height:80px; border-radius:50%; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); display:flex; align-items:center; justify-content:center; color:white; font-size:36px; font-weight:bold;">
                <span id="view-gv-initial">T</span>
              </div>
              <div style="flex:1;">
                <h3 id="view-gv-name" style="margin:0 0 4px 0; font-size:20px; color:#1e293b;">Trần Thị Bình</h3>
                <p id="view-gv-code-subject" style="margin:0; color:#64748b; font-size:14px;">Mã GV: 2 - Bộ môn: Vật lý 10</p>
              </div>
            </div>
            <div style="margin-bottom:24px;">
              <h4 style="margin:0 0 12px 0; color:#334155; font-size:16px; font-weight:600;">📋 Thông tin cơ bản</h4>
              <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div class="sp-field">
                  <label>Giới tính</label>
                  <input type="text" id="view-gv-gender" readonly style="background:#f1f5f9; cursor:default;" />
                </div>
                <div class="sp-field">
                  <label>Ngày sinh</label>
                  <input type="text" id="view-gv-dob" readonly style="background:#f1f5f9; cursor:default;" />
                </div>
              </div>
              <div class="sp-field">
                <label>Email</label>
                <input type="text" id="view-gv-email" readonly style="background:#f1f5f9; cursor:default;" />
              </div>
              <div class="sp-field">
                <label>Địa chỉ</label>
                <input type="text" id="view-gv-address" readonly style="background:#f1f5f9; cursor:default;" />
              </div>
            </div>
            <div style="margin-bottom:24px;">
              <h4 style="margin:0 0 12px 0; color:#334155; font-size:16px; font-weight:600;">📚 Các lớp đang giảng dạy</h4>
              <div id="view-gv-teaching-classes" style="display:flex; flex-wrap:wrap; gap:8px;">
                <span style="padding:6px 12px; background:#e0e7ff; color:#4f46e5; border-radius:6px; font-size:13px;">10A1</span>
                <span style="padding:6px 12px; background:#dbeafe; color:#2563eb; border-radius:6px; font-size:13px;">10A2</span>
                <span style="padding:6px 12px; background:#fce7f3; color:#db2777; border-radius:6px; font-size:13px;">11A1</span>
              </div>
            </div>
            <div style="margin-bottom:24px;">
              <h4 style="margin:0 0 12px 0; color:#334155; font-size:16px; font-weight:600;">🏫 Lớp chủ nhiệm</h4>
              <div id="view-gv-homeroom" style="padding:12px 16px; background:#dcfce7; border-left:4px solid #16a34a; border-radius:6px;">
                <strong style="color:#166534; font-size:15px;">10A1</strong>
                <span style="color:#15803d; font-size:13px; margin-left:8px;">(35 học sinh)</span>
              </div>
            </div>

            <div class="sp-actions">
              <button
                type="button"
                class="sp-btn sp-btn--ghost"
                onclick="closeViewTeacherModal()"
              >
                Đóng
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="sp-overlay" id="modal-add-teacher" style="display:none;">
        <div class="sp-modal">
          <h2 class="sp-title">Thêm giáo viên mới</h2>
          
          <form class="sp-form" id="form-add-teacher" method="POST" action="/teacher">
            <div style="display:grid; grid-template-columns:1fr; gap:14px;">
              <div class="sp-field">
                <label>Bộ môn giảng dạy <span style="color:#64748b; font-size:12px;">(có thể chọn nhiều)</span></label>
                <div style="max-height:200px; overflow-y:auto; border:1px solid #cbd5e1; border-radius:6px; padding:8px; background:#fff;">
                  <% if (subjects && subjects.length) { %>
                    <% subjects.forEach(function(sub){ %>
                      <label style="display:flex; align-items:center; gap:8px; padding:6px; cursor:pointer; border-radius:4px; transition:background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                        <input type="checkbox" name="MonHocs" value="<%= sub.MaMonHoc %>" style="cursor:pointer;" />
                        <span><%= sub.TenMonHoc %> (<%= sub.MaMonHoc %>)</span>
                      </label>
                    <% }) %>
                  <% } else { %>
                    <p style="color:#94a3b8; padding:8px;">Chưa có môn học</p>
                  <% } %>
                </div>
                <input type="hidden" name="MaMonGiangDay" id="add-gv-mon" />
              </div>
            </div>

            <div class="sp-field">
              <label>Họ tên</label>
              <input type="text" name="HoTen" id="add-gv-hoten" placeholder="Nhập họ và tên" required />
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
              <div class="sp-field">
                <label>Giới tính</label>
                <select name="GioiTinh" id="add-gv-gioitinh" required>
                  <option value="">-- Chọn --</option>
                  <option value="Nam">Nam</option>
                  <option value="Nữ">Nữ</option>
                  <option value="Khác">Khác</option>
                </select>
              </div>

              <div class="sp-field">
                <label>Ngày sinh</label>
                <input type="date" name="NgaySinh" id="add-gv-ngaysinh" required />
              </div>
            </div>

            <div class="sp-field">
              <label>Email</label>
              <input type="email" name="Email" id="add-gv-email" placeholder="example@school.edu.vn" required />
            </div>

            <div class="sp-field">
              <label>Địa chỉ</label>
              <input type="text" name="DiaChi" id="add-gv-diachi" placeholder="Nhập địa chỉ" />
            </div>

            <div class="sp-actions">
              <button
                type="button"
                class="sp-btn sp-btn--ghost"
                onclick="closeAddTeacherModal()"
              >
                Hủy
              </button>
              <button type="submit" class="sp-btn">
                Thêm giáo viên
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <script>
    const subFilter = document.getElementById('filter-subject');
    const searchBox = document.getElementById('search-teacher');
    const tbody = document.querySelector('#tbl-teachers tbody');

    function applyFilter(){
      const s = (searchBox.value || '').toLowerCase().trim();
      const subject = (subFilter.value || '').toLowerCase().trim();

      [...tbody.rows].forEach(tr => {
        const name     = tr.getAttribute('data-name')     || '';
        const sub      = tr.getAttribute('data-subject')  || '';
        const contact  = tr.getAttribute('data-contact')  || '';
        const address  = tr.getAttribute('data-address')  || '';

        const okSearch =
          !s ||
          name.includes(s) ||
          contact.includes(s) ||
          address.includes(s);

        const okSub = !subject || sub === subject;

        tr.style.display = (okSearch && okSub) ? '' : 'none';
      });
    }

    subFilter.addEventListener('change', applyFilter);
    searchBox.addEventListener('input', applyFilter);

    // Bắt click Xem / Sửa
    document.addEventListener('click', (e)=>{
      // Kiểm tra nếu click vào button hoặc text bên trong button
      const viewBtn = e.target.closest('[data-view]');
      const editBtn = e.target.closest('[data-edit]');

      if (viewBtn) {
        e.preventDefault();
        e.stopPropagation();
        const id = viewBtn.getAttribute('data-view');
        if (id) {
          openViewTeacherModal(id);
        }
        return false;
      }

      if (editBtn) {
        e.preventDefault();
        e.stopPropagation();
        console.log('Edit button clicked:', editBtn);
        openEditTeacherModal(editBtn);
        return false;
      }
    });

    // Nút Thêm và Xuất
    (function(){
      const btnAdd = document.getElementById('btn-add');
      if (btnAdd) {
        btnAdd.addEventListener('click', () => {
          openAddTeacherModal();
        });
      }
      const btnExport = document.getElementById('btn-export');
      if (btnExport) {
        btnExport.addEventListener('click', () => {
          alert('Xuất danh sách giáo viên (demo) – chưa nối API.');
        });
      }
    })();

    // ========== MODAL XEM CHI TIẾT ==========
    function openViewTeacherModal(teacherId) {
      const modal = document.getElementById('modal-view-teacher');
      if (!modal) return;

      // Lấy thông tin từ dòng table (demo)
      const row = document.querySelector(`[data-view="${teacherId}"]`)?.closest('tr');
      const teacherName = row?.children[1]?.textContent || 'Giáo viên';
      const initial = teacherName.charAt(0).toUpperCase();
      const subject = row?.children[2]?.textContent || '';
      const email = row?.children[3]?.textContent || '';
      const address = row?.children[4]?.textContent || '';
      
      document.getElementById('view-gv-initial').textContent = initial;
      document.getElementById('view-gv-name').textContent = teacherName;
      document.getElementById('view-gv-code-subject').textContent = `Mã GV: ${teacherId} - Bộ môn: ${subject}`;
      document.getElementById('view-gv-gender').value = 'Nữ'; // Demo
      document.getElementById('view-gv-dob').value = '15/03/1985'; // Demo
      document.getElementById('view-gv-email').value = email;
      document.getElementById('view-gv-address').value = address;

      modal.style.display = 'grid';
    }

    function closeViewTeacherModal() {
      const modal = document.getElementById('modal-view-teacher');
      if (modal) modal.style.display = 'none';
    }

    document.getElementById('modal-view-teacher')?.addEventListener('click', (e) => {
      if (e.target.classList.contains('sp-overlay')) {
        closeViewTeacherModal();
      }
    });

    // ========== MODAL THÊM GIÁO VIÊN ==========
    function openAddTeacherModal() {
      const modal = document.getElementById('modal-add-teacher');
      if (!modal) return;

      // Reset form
      document.getElementById('form-add-teacher').reset();
      modal.style.display = 'grid';
    }

    function closeAddTeacherModal() {
      const modal = document.getElementById('modal-add-teacher');
      if (modal) modal.style.display = 'none';
    }

    document.getElementById('modal-add-teacher')?.addEventListener('click', (e) => {
      if (e.target.classList.contains('sp-overlay')) {
        closeAddTeacherModal();
      }
    });

    // Xử lý submit form add
    document.getElementById('form-add-teacher')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const form = e.target;
      
      // Lấy tất cả các checkbox đã chọn
      const monHocs = Array.from(form.querySelectorAll('input[name="MonHocs"]:checked')).map(cb => cb.value);
      if (monHocs.length === 0) {
        alert('Vui lòng chọn ít nhất một môn học');
        return;
      }
      
      // Tạo object dữ liệu (không gửi MaGiaoVien, để hệ thống tự động tạo)
      const formData = new FormData(form);
      const data = {
        HoTen: formData.get('HoTen') || '',
        GioiTinh: formData.get('GioiTinh') || '',
        NgaySinh: formData.get('NgaySinh') || '',
        DiaChi: formData.get('DiaChi') || '',
        Email: formData.get('Email') || '',
        MaMonGiangDay: monHocs[0] || '',
        MonHocs: monHocs
      };
      
      // Submit form với JSON
      fetch('/teacher', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data)
      })
      .then(async res => {
        // Clone response để có thể đọc nhiều lần nếu cần
        const contentType = res.headers.get('content-type');
        const isJson = contentType && contentType.includes('application/json');
        
        if (res.ok) {
          if (isJson) {
            const result = await res.json();
            window.location.href = '/teacher?success=' + encodeURIComponent(result.message || 'Thêm giáo viên thành công');
          } else {
            window.location.href = '/teacher?success=' + encodeURIComponent('Thêm giáo viên thành công');
          }
        } else {
          // Xử lý lỗi
          let errorMessage = 'Có lỗi xảy ra';
          
          if (isJson) {
            try {
              const errorData = await res.json();
              errorMessage = errorData.error || errorData.message || 'Có lỗi xảy ra';
            } catch (parseErr) {
              console.error('Lỗi parse JSON:', parseErr);
              errorMessage = 'Có lỗi xảy ra khi xử lý phản hồi từ server';
            }
          } else {
            try {
              const text = await res.text();
              errorMessage = text || 'Có lỗi xảy ra';
            } catch (textErr) {
              console.error('Lỗi đọc text:', textErr);
              errorMessage = `Lỗi ${res.status}: ${res.statusText}`;
            }
          }
          
          throw new Error(errorMessage);
        }
      })
      .catch(err => {
        const errorMessage = err.message || 'Không thêm được giáo viên';
        alert('Lỗi: ' + errorMessage);
        console.error('Lỗi khi thêm giáo viên:', err);
      });
    });

    // ========== MODAL SỬA GIÁO VIÊN ==========
    function openEditTeacherModal(btn) {
      console.log('openEditTeacherModal called with:', btn);
      const modal = document.getElementById('modal-edit-teacher');
      if (!modal) {
        console.error('Modal edit teacher không tìm thấy');
        alert('Không tìm thấy modal sửa giáo viên. Vui lòng reload trang.');
        return;
      }

      const maGV    = btn.getAttribute('data-magv') || btn.getAttribute('data-edit') || '';
      const hoTen   = btn.getAttribute('data-hoten') || '';
      const gioiTinh= btn.getAttribute('data-gioitinh') || '';
      const ngaySinhRaw = btn.getAttribute('data-ngaysinh') || '';
      const ngaySinh = ngaySinhRaw ? ngaySinhRaw.substring(0,10) : '';
      const diaChi  = btn.getAttribute('data-diachi') || '';
      const email   = btn.getAttribute('data-email') || '';
      const maMon   = btn.getAttribute('data-mamon') || '';

      console.log('Teacher data:', { maGV, hoTen, email, maMon });

      const magvInput = document.getElementById('edit-gv-magv');
      const magvHidden = document.getElementById('edit-gv-magv-hidden');
      if (magvInput) magvInput.value = maGV;
      if (magvHidden) magvHidden.value = maGV;
      
      const hoTenInput = document.getElementById('edit-gv-hoten');
      if (hoTenInput) hoTenInput.value = hoTen;
      
      const gioiTinhSelect = document.getElementById('edit-gv-gioitinh');
      if (gioiTinhSelect) gioiTinhSelect.value = gioiTinh;
      
      const ngaySinhInput = document.getElementById('edit-gv-ngaysinh');
      if (ngaySinhInput) ngaySinhInput.value = ngaySinh;
      
      const diaChiInput = document.getElementById('edit-gv-diachi');
      if (diaChiInput) diaChiInput.value = diaChi;
      
      const emailInput = document.getElementById('edit-gv-email');
      if (emailInput) emailInput.value = email;

      // Xử lý môn học (nhiều môn)
      const monHocsJson = btn.getAttribute('data-monhocs') || '[]';
      let monHocs = [];
      try {
        monHocs = JSON.parse(monHocsJson);
      } catch(e) {
        // Fallback về maMon nếu không có data-monhocs
        if (maMon) monHocs = [maMon];
      }
      
      // Check các checkbox tương ứng
      const checkboxes = document.querySelectorAll('.edit-gv-mon-checkbox');
      checkboxes.forEach(cb => {
        cb.checked = monHocs.includes(cb.value);
      });
      
      // Cập nhật hidden field
      const monHidden = document.getElementById('edit-gv-mon');
      if (monHidden) monHidden.value = monHocs[0] || maMon || '';

      modal.style.display = 'grid';
      console.log('Modal displayed');
    }

    function closeEditTeacherModal() {
      const modal = document.getElementById('modal-edit-teacher');
      if (modal) modal.style.display = 'none';
    }

    document.getElementById('modal-edit-teacher')?.addEventListener('click', (e) => {
      if (e.target.classList.contains('sp-overlay')) {
        closeEditTeacherModal();
      }
    });

    // Xử lý submit form edit
    document.getElementById('form-edit-teacher')?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Lấy tất cả các checkbox đã chọn
      const monHocs = Array.from(document.querySelectorAll('.edit-gv-mon-checkbox:checked')).map(cb => cb.value);
      if (monHocs.length === 0) {
        alert('Vui lòng chọn ít nhất một môn học');
        return;
      }
      
      // Tạo object dữ liệu
      const maGV = document.getElementById('edit-gv-magv-hidden')?.value || document.getElementById('edit-gv-magv')?.value;
      if (!maGV) {
        alert('Lỗi: Không tìm thấy mã giáo viên');
        return;
      }
      
      const data = {
        MaGiaoVien: maGV,
        HoTen: document.getElementById('edit-gv-hoten')?.value || '',
        GioiTinh: document.getElementById('edit-gv-gioitinh')?.value || '',
        NgaySinh: document.getElementById('edit-gv-ngaysinh')?.value || '',
        Email: document.getElementById('edit-gv-email')?.value || '',
        DiaChi: document.getElementById('edit-gv-diachi')?.value || '',
        MaMonGiangDay: monHocs[0] || '', // Tương thích ngược
        MonHocs: monHocs
      };
      
      // Submit form với JSON
      fetch('/teacher/edit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data)
      })
      .then(res => {
        if (res.ok) {
          window.location.href = '/teacher?success=' + encodeURIComponent('Cập nhật giáo viên thành công');
        } else {
          return res.text().then(text => {
            throw new Error(text || 'Có lỗi xảy ra');
          });
        }
      })
      .catch(err => {
        alert('Lỗi: ' + (err.message || 'Không cập nhật được giáo viên'));
      });
    });

    // Xóa giáo viên
    document.addEventListener('click', (e) => {
      const deleteBtn = e.target.closest('[data-delete]');
      if (deleteBtn) {
        const maGV = deleteBtn.getAttribute('data-delete');
        const hoTen = deleteBtn.getAttribute('data-hoten') || '';
        showDeleteConfirm(
          `Bạn có chắc chắn muốn xóa giáo viên "${hoTen}" (Mã: ${maGV})?`,
          '⚠️ Hành động này không thể hoàn tác!',
          function() {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/teacher/delete';
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'MaGiaoVien';
          input.value = maGV;
          form.appendChild(input);
          document.body.appendChild(form);
          form.submit();
        }
        );
      }
    });
  </script>
</body>
</html>
