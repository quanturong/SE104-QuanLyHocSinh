<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Tạo tài khoản – Quản lí học sinh</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page-student">
  <div class="layout">
    <%- include('../partials/sidebar') %>

    <main class="main">
      <div class="page-header">
        <h1 class="page-title">Tạo tài khoản mới</h1>
        <p class="page-desc">
          Tạo tài khoản người dùng mới cho hệ thống. Mật khẩu sẽ được mã hóa an toàn.
        </p>
      </div>

      <section class="card">
        <% if (error) { %>
          <div style="background: #fee; color: #c33; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #fcc;">
            <strong>❌ Lỗi:</strong> <%- error %>
          </div>
        <% } %>

        <% if (success) { %>
          <div style="background: #efe; color: #3c3; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #cfc;">
            <strong>✅ Thành công:</strong> <%= success %>
          </div>
        <% } %>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
          <div>
            <h2 style="margin-bottom: 16px; font-size: 18px;">Tạo tài khoản thủ công</h2>
            <form method="POST" action="/create-user" style="max-width: 100%;">
          <div style="margin-bottom: 20px;">
            <label class="class-label" for="TenDangNhap">
              Tên đăng nhập <span style="color: #c33;">*</span>
            </label>
            <input
              type="text"
              id="TenDangNhap"
              name="TenDangNhap"
              class="input"
              placeholder="Nhập tên đăng nhập (email hoặc username)"
              value="<%= formData && formData.TenDangNhap ? formData.TenDangNhap : '' %>"
              required
              style="width: 100%;"
            />
          </div>

          <div style="margin-bottom: 20px;">
            <label class="class-label" for="MatKhau">
              Mật khẩu <span style="color: #c33;">*</span>
            </label>
            <input
              type="password"
              id="MatKhau"
              name="MatKhau"
              class="input"
              placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)"
              minlength="6"
              required
              style="width: 100%;"
            />
            <small style="color: #666; font-size: 13px; margin-top: 4px; display: block;">
              Mật khẩu sẽ được mã hóa bằng bcrypt trước khi lưu vào database.
            </small>
          </div>

          <div style="margin-bottom: 24px;">
            <label class="class-label" for="VaiTro">
              Vai trò <span style="color: #c33;">*</span>
            </label>
            <select
              id="VaiTro"
              name="VaiTro"
              class="select class-select"
              required
              style="width: 100%;"
            >
              <option value="">-- Chọn vai trò --</option>
              <option value="Admin" <%= formData && formData.VaiTro === 'Admin' ? 'selected' : '' %>>Admin - Quản trị viên</option>
              <option value="BGH" <%= formData && formData.VaiTro === 'BGH' ? 'selected' : '' %>>BGH - Ban Giám Hiệu</option>
              <option value="GiaoVu" <%= formData && formData.VaiTro === 'GiaoVu' ? 'selected' : '' %>>GiaoVu - Giáo vụ</option>
              <option value="GiaoVien" <%= formData && formData.VaiTro === 'GiaoVien' ? 'selected' : '' %>>GiaoVien - Giáo viên</option>
              <option value="HocSinh" <%= formData && formData.VaiTro === 'HocSinh' ? 'selected' : '' %>>HocSinh - Học sinh</option>
            </select>
          </div>

          <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn" style="flex: 1;">
              ➕ Tạo tài khoản
            </button>
            <a href="/tablecontrol" class="btn btn-ghost" style="flex: 1; text-align: center; text-decoration: none;">
              Hủy
            </a>
          </div>
        </form>
          </div>

          <div>
            <h2 style="margin-bottom: 16px; font-size: 18px;">Import từ file CSV</h2>
            <form method="POST" action="/import-users-csv" enctype="multipart/form-data" style="max-width: 100%;">
              <div style="margin-bottom: 20px;">
                <label class="class-label" for="csvFile">
                  Chọn file CSV <span style="color: #c33;">*</span>
                </label>
                <input
                  type="file"
                  id="csvFile"
                  name="csvFile"
                  accept=".csv"
                  required
                  style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;"
                />
                <small style="color: #666; font-size: 13px; margin-top: 4px; display: block;">
                  File CSV phải có định dạng: TenDangNhap,MatKhau,VaiTro<br>
                  <span style="color: #999;">(Mã người dùng sẽ được tự động tạo)</span>
                </small>
              </div>

              <div style="display: flex; gap: 12px;">
                <button type="submit" class="btn" style="flex: 1;">
                  📤 Import CSV
                </button>
                <a href="/tablecontrol" class="btn btn-ghost" style="flex: 1; text-align: center; text-decoration: none;">
                  Hủy
                </a>
              </div>
            </form>
          </div>
        </div>
      </section>

      <section class="card" style="margin-top: 32px;">
        <div class="page-header" style="margin-bottom: 16px;">
          <h2 style="font-size: 18px;">Quản lý phân quyền người dùng</h2>
          <p class="page-desc" style="margin: 0;">Cập nhật vai trò (phân quyền) cho các tài khoản trong hệ thống.</p>
        </div>

        <div class="toolbar" style="margin-bottom: 16px;">
          <button class="btn" id="btn-refresh-users">🔄 Làm mới danh sách</button>
        </div>

        <div class="table-wrap" style="overflow:auto; max-height:500px;">
          <table class="table" id="tbl-users">
            <thead>
              <tr>
                <th style="width:60px;">STT</th>
                <th style="width:200px;">TÊN ĐĂNG NHẬP</th>
                <th style="width:200px;">VAI TRÒ HIỆN TẠI</th>
                <th style="width:200px;">THAY ĐỔI VAI TRÒ</th>
                <th style="width:200px;">THAO TÁC</th>
              </tr>
            </thead>
            <tbody id="users-tbody">
              <tr>
                <td colspan="5" class="text-center muted">Đang tải danh sách người dùng...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <!-- Include delete confirm modal -->
  <%- include('../partials/delete-confirm-modal') %>

  <script>
    async function loadUsers() {
      try {
        const response = await fetch('/api/users');
        const users = await response.json();
        const tbody = document.getElementById('users-tbody');
        
        if (!users || users.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center muted">Chưa có người dùng nào trong hệ thống.</td></tr>';
          return;
        }

        // Lấy username của user hiện tại từ session
        const currentUsername = '<%= (typeof user !== "undefined" && user && user.username) ? user.username : "" %>';

        tbody.innerHTML = users.map((user, index) => {
          // So sánh TenDangNhap với username trong session
          // Vì username trong session có thể là MaHocSinh (cho học sinh) hoặc TenDangNhap
          const isCurrentUser = user.TenDangNhap === currentUsername || 
                                (currentUsername && user.TenDangNhap && 
                                 (user.TenDangNhap.toLowerCase() === currentUsername.toLowerCase()));
          return `
            <tr>
              <td class="text-center">${index + 1}</td>
              <td><strong>${user.TenDangNhap || ''}</strong></td>
              <td><span class="pill">${user.VaiTro || ''}</span></td>
              <td>
                <select class="select" style="width:100%;" data-username="${user.TenDangNhap}" data-current="${user.VaiTro}">
                  <option value="Admin" ${user.VaiTro === 'Admin' ? 'selected' : ''}>Admin</option>
                  <option value="BGH" ${user.VaiTro === 'BGH' ? 'selected' : ''}>BGH</option>
                  <option value="GiaoVu" ${user.VaiTro === 'GiaoVu' ? 'selected' : ''}>GiaoVu</option>
                  <option value="GiaoVien" ${user.VaiTro === 'GiaoVien' ? 'selected' : ''}>GiaoVien</option>
                  <option value="HocSinh" ${user.VaiTro === 'HocSinh' ? 'selected' : ''}>HocSinh</option>
                </select>
              </td>
              <td style="display: flex; gap: 8px;">
                <button class="btn btn-sm btn-update-role" data-username="${user.TenDangNhap}">Cập nhật</button>
                ${isCurrentUser ? '' : `<button class="btn btn-sm" style="background: #dc3545; color: white;" onclick="deleteUser('${user.TenDangNhap}')">Xóa</button>`}
              </td>
            </tr>
          `;
        }).join('');

        // Attach event listeners
        document.querySelectorAll('.btn-update-role').forEach(btn => {
          btn.addEventListener('click', async function() {
            const username = this.getAttribute('data-username');
            const select = document.querySelector(`select[data-username="${username}"]`);
            const newRole = select.value;
            const currentRole = select.getAttribute('data-current');

            if (newRole === currentRole) {
              // Tự động reset về giá trị cũ và không hiển thị thông báo
              select.value = currentRole;
              return;
            }

            if (!confirm(`Bạn có chắc muốn thay đổi vai trò của "${username}" từ "${currentRole}" sang "${newRole}"?`)) {
              select.value = currentRole;
              return;
            }

            try {
              const formData = new FormData();
              formData.append('TenDangNhap', username);
              formData.append('VaiTro', newRole);

              const response = await fetch('/user/permission', {
                method: 'POST',
                body: formData
              });

              if (response.ok) {
                alert('Cập nhật phân quyền thành công!');
                loadUsers();
              } else {
                const errorText = await response.text();
                alert('Lỗi: ' + errorText);
                select.value = currentRole;
              }
            } catch (err) {
              alert('Lỗi khi cập nhật: ' + err.message);
              select.value = currentRole;
            }
          });
        });
      } catch (err) {
        console.error('Lỗi loadUsers:', err);
        document.getElementById('users-tbody').innerHTML = '<tr><td colspan="5" class="text-center muted">Lỗi khi tải danh sách người dùng.</td></tr>';
      }
    }

    document.getElementById('btn-refresh-users')?.addEventListener('click', loadUsers);

    async function deleteUser(username) {
      if (!username) {
        alert('Lỗi: Không có tên đăng nhập');
        return;
      }

      showDeleteConfirm(
        `Bạn có chắc chắn muốn xóa tài khoản "${username}"?`,
        '⚠️ Hành động này không thể hoàn tác! Tài khoản và tất cả dữ liệu liên quan sẽ bị xóa vĩnh viễn.',
        async function() {
          try {
        const response = await fetch('/user/delete', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ TenDangNhap: username })
        });

            const result = await response.json();

            if (response.ok && result.success) {
              alert(result.message || 'Xóa tài khoản thành công!');
              loadUsers(); // Reload danh sách
            } else {
              alert('Lỗi: ' + (result.error || 'Không thể xóa tài khoản'));
            }
          } catch (err) {
            console.error('Lỗi khi xóa người dùng:', err);
            alert('Lỗi khi xóa tài khoản: ' + err.message);
          }
        }
      );
    }

    // Expose deleteUser to global scope for onclick handler
    window.deleteUser = deleteUser;

    loadUsers();
  </script>
</body>
</html>

