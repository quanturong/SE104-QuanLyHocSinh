<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Danh sách học sinh – Quản lí học sinh</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page-student">
  <div class="layout">
    <aside class="sidebar">
      <div class="brand">
        <div class="logo">🎓</div>
        <span>Student Management – Quản lí học sinh</span>
      </div>

      <%
        const role = (user && user.role) ? user.role : "";
        const canManageStudents = permissions && permissions.canManageStudents;
      %>

      <nav class="nav">
        <a class="<%= title === 'Bảng điều khiển' ? 'active' : '' %>" href="/tablecontrol">
          Bảng điều khiển
        </a>
        <% if (role !== 'HocSinh') { %>
          <a class="<%= title === 'Danh sách học sinh' ? 'active' : '' %>" href="/student">
            Học sinh
          </a>
          <a class="<%= title === 'Danh sách lớp' ? 'active' : '' %>" href="/class">
            Lớp học
          </a>
          <a class="<%= title === 'Điểm danh' ? 'active' : '' %>" href="/attendance">
            Điểm danh
          </a>
          <a class="<%= title === 'Báo cáo' ? 'active' : '' %>" href="/report">
            Báo cáo
          </a>
        <% } %>
        <a class="<%= title === 'Bảng điểm' ? 'active' : '' %>" href="/scoretable">
          Điểm số
        </a>
        <% if (role !== 'HocSinh') { %>
          <a class="<%= title === 'Tra cứu' ? 'active' : '' %>" href="/find">
            Tra cứu
          </a>
        <% } %>
        <a class="<%= title === 'Thời khóa biểu' ? 'active' : '' %>" href="/timetable">
          Thời khóa biểu
        </a>
        <a class="<%= title === 'Danh sách giáo viên' ? 'active' : '' %>" href="/teacher">
          Giáo viên
        </a>
        <% if (role === 'Admin' || role === 'BGH' || role === 'GiaoVu') { %>
          <a class="<%= title === 'Quản lý môn học' ? 'active' : '' %>" href="/subject">
            📚 Môn học
          </a>
        <% } %>
        <a class="<%= title === 'Quy định' ? 'active' : '' %>" href="/rules">
          Quy định
        </a>
        <% if (role === 'Admin') { %>
          <a class="<%= title === 'Tạo tài khoản' ? 'active' : '' %>" href="/create-user">
            👤 Tạo tài khoản
          </a>
        <% } %>
      </nav>
      <div class="spacer"></div>
      <a class="nav logout" href="/logout">Đăng xuất</a>
    </aside>

    <main class="main">
      <!-- Include notification modal -->
      <%- include('../partials/notification-modal') %>

      <!-- Overlay thêm học sinh -->
      <div id="student-overlay" class="sp-overlay" style="display:none;">
        <div class="sp-modal">
          <h2 class="sp-title">Thêm học sinh</h2>

          <form class="sp-form" method="POST" action="/student">
            <div class="sp-field">
              <label>Họ tên</label>
              <input name="HoTen" placeholder="VD: Nguyễn Văn A" required />
            </div>

            <div class="sp-field">
              <label>Giới tính</label>
              <select name="GioiTinh" required>
                <option value="Nam">Nam</option>
                <option value="Nữ">Nữ</option>
              </select>
            </div>

            <div class="sp-field">
              <label>Ngày sinh</label>
              <input type="date" name="NgaySinh" required />
            </div>

            <div class="sp-field">
              <label>Địa chỉ</label>
              <input name="DiaChi" placeholder="VD: Quận 1, TP.HCM" required />
            </div>

            <div class="sp-field">
              <label>Email</label>
              <input type="email" name="Email" placeholder="VD: hs001@school.com" required />
            </div>

            <div class="sp-field">
              <label>Mã lớp</label>
              <input name="MaLop" placeholder="VD: 12A1" required />
            </div>

            <div class="sp-actions">
              <button type="button" class="sp-btn sp-btn--ghost" id="btn-cancel-student">
                Đóng
              </button>
              <button type="submit" class="sp-btn">
                Lưu
              </button>
            </div>
          </form>
        </div>
      </div>
      <div id="student-edit-overlay" class="sp-overlay" style="display:none;">
        <div class="sp-modal">
          <h2 class="sp-title">Sửa học sinh</h2>

          <form class="sp-form" method="POST" action="/student/edit">
            <input type="hidden" name="OldMaHocSinh" id="oldMaHocSinh" />
            <input type="hidden" name="MaHocSinh" id="editMaHocSinh" />

            <div class="sp-field">
              <label>Họ tên</label>
              <input name="HoTen" id="editHoTen" required />
            </div>

            <div class="sp-field">
              <label>Giới tính</label>
              <select name="GioiTinh" id="editGioiTinh" required>
                <option value="Nam">Nam</option>
                <option value="Nữ">Nữ</option>
              </select>
            </div>

            <div class="sp-field">
              <label>Ngày sinh</label>
              <input type="date" name="NgaySinh" id="editNgaySinh" required />
            </div>

            <div class="sp-field">
              <label>Địa chỉ</label>
              <input name="DiaChi" id="editDiaChi" required />
            </div>

            <div class="sp-field">
              <label>Email</label>
              <input type="email" name="Email" id="editEmail" required />
            </div>

            <div class="sp-field">
              <label>Mã lớp</label>
              <input name="MaLop" id="editMaLop" required />
            </div>

            <div class="sp-actions">
              <button type="button" class="sp-btn sp-btn--ghost" id="btn-cancel-edit">
                Đóng
              </button>
              <button type="submit" class="sp-btn">
                Lưu thay đổi
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="page-header">
        <h1 class="page-title">Danh sách học sinh</h1>
        <p class="page-desc">
          Dữ liệu hiển thị trực tiếp từ bảng <strong>HoSoHocSinh</strong> (MaHocSinh, HoTen, GioiTinh, NgaySinh, DiaChi, Email, MaLop).
        </p>
      </div>

      <section class="card" style="margin-bottom: 16px;">
        <div class="toolbar" style="justify-content: space-between;">
          <div>
            <div style="font-weight: 600; font-size: 16px;">
              <%= (students && students.length) ? students.length : 0 %> học sinh
            </div>
            <div class="muted" style="font-size: 13px;">
              Mỗi dòng tương ứng một bản ghi trong <code>HoSoHocSinh</code>.
            </div>
          </div>

          <div style="display:flex; gap:8px; align-items:center;">
            <input
              class="input"
              id="search-name"
              placeholder="Tìm theo họ tên hoặc mã HS..."
              style="min-width: 240px;"
            />
            <select class="select" id="filter-gender">
              <option value="">Tất cả giới tính</option>
              <option value="Nam">Nam</option>
              <option value="Nữ">Nữ</option>
            </select>
            <select class="select" id="filter-class">
              <option value="">Tất cả lớp</option>
              <% if (students && students.length) {
                   const set = new Set();
                   students.forEach(s => { if (s.MaLop) set.add(s.MaLop); });
                   Array.from(set).sort().forEach(function(lop){ %>
                     <option value="<%= lop %>"><%= lop %></option>
              <%   });
                 } %>
            </select>

            <!-- Year filter added: chọn Năm học để tính toán TB/HK/Xếp loại -->
            <select class="select" id="filter-year">
              <% if (years && years.length) { %>
                <% years.forEach(function(y){ %>
                  <option value="<%= y %>" <%= (selectedYear === y) ? 'selected' : '' %>><%= y %></option>
                <% }) %>
              <% } else { %>
                <option value="">Chưa có năm học</option>
              <% } %>
            </select>

            <% if (canManageStudents) { %>
              <button class="btn" id="btn-add">+ Thêm học sinh</button>
            <% } %>
            <button class="btn btn-export" id="btn-export">📊 Xuất Excel</button>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="table-wrap" style="overflow:auto; max-height:560px;">
          <table class="table" id="tbl-students">
            <thead>
              <tr>
                <th style="width:60px;">STT</th>
                <th style="width:90px;">MÃ HS</th>
                <th style="width:220px;">HỌ TÊN</th>
                <th style="width:90px;">GIỚI TÍNH</th>
                <th style="width:130px;">NGÀY SINH</th>
                <th style="width:220px;">ĐỊA CHỈ</th>
                <th style="width:160px;">EMAIL</th>
                <th style="width:80px;">LỚP</th>
                <!-- Thêm cột điểm và đánh giá -->
                <th style="width:90px;">TB HK1</th>
                <th style="width:90px;">TB HK2</th>
                <th style="width:90px;">TB CN</th>
                <th style="width:120px;">HẠNH KIỂM</th>
                <th style="width:120px;">XẾP LOẠI</th>
                <% if (canManageStudents) { %>
                  <th style="width:110px;">THAO TÁC</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% if (students && students.length) { %>
                <% students.forEach(function(st, index) { %>
                  <tr
                    data-name="<%= ((st.HoTen || '') + ' ' + (st.MaHocSinh || '')).toLowerCase() %>"
                    data-gender="<%= (st.GioiTinh || '').toLowerCase() %>"
                    data-class="<%= (st.MaLop || '').toLowerCase() %>"
                    data-mahs="<%= st.MaHocSinh %>"
                    data-hoten="<%= st.HoTen %>"
                    data-gioitinh="<%= st.GioiTinh || '' %>"
                    data-ngaysinh="<%= st.NgaySinh || '' %>"
                    data-diachi="<%= st.DiaChi || '' %>"
                    data-email="<%= st.Email || '' %>"
                    data-malop="<%= st.MaLop || '' %>"
                    data-tbhk1="<%= (st.TB_HK1 !== undefined ? st.TB_HK1 : '') %>"
                    data-tbhk2="<%= (st.TB_HK2 !== undefined ? st.TB_HK2 : '') %>"
                    data-tbcn="<%= (st.TB_CN !== undefined ? st.TB_CN : '') %>"
                    data-hanhkiem="<%= st.HanhKiem || '' %>"
                    data-xeploai="<%= st.XepLoai || '' %>"
                  >
                    <td class="text-center"><%= index + 1 %></td>
                    <td><%= st.MaHocSinh %></td>
                    <td><strong><%= st.HoTen %></strong></td>
                    <td><%= st.GioiTinh || '' %></td>
                    <td><%= st.NgaySinh || '' %></td>
                    <td><%= st.DiaChi || '' %></td>
                    <td><%= st.Email || '' %></td>
                    <td><%= st.MaLop || '' %></td>

                    <!-- TB HK1 -->
                    <td class="text-center score-cell">
                      <% if (st.TB_HK1_Style && st.TB_HK1_Style !== 'none') { %>
                        <span class="score score-<%= st.TB_HK1_Style %>"><%= st.TB_HK1 %></span>
                      <% } else { %>
                        <span class="muted">-</span>
                      <% } %>
                    </td>

                    <!-- TB HK2 -->
                    <td class="text-center score-cell">
                      <% if (st.TB_HK2_Style && st.TB_HK2_Style !== 'none') { %>
                        <span class="score score-<%= st.TB_HK2_Style %>"><%= st.TB_HK2 %></span>
                      <% } else { %>
                        <span class="muted">-</span>
                      <% } %>
                    </td>

                    <!-- TB CN -->
                    <td class="text-center score-cell">
                      <% if (st.TB_CN_Style && st.TB_CN_Style !== 'none') { %>
                        <span class="score score-<%= st.TB_CN_Style %>"><%= st.TB_CN %></span>
                      <% } else { %>
                        <span class="muted">-</span>
                      <% } %>
                    </td>

                    <!-- Hạnh kiểm -->
                    <td class="text-center">
                      <% const hkStyle = (st.HanhKiem_Style === 'good') ? 'b-success' : (st.HanhKiem_Style === 'average') ? 'b-info' : (st.HanhKiem_Style === 'average-low') ? 'b-secondary' : (st.HanhKiem_Style === 'fail') ? 'b-warn' : '' %>
                      <span class="badge <%= hkStyle %>"><%= st.HanhKiem %></span>
                    </td>

                    <!-- Xếp loại -->
                    <td class="text-center">
                      <% const xlStyle = (st.XepLoai_Style === 'good' || st.XepLoai_Style === 'excellent') ? 'b-success' : (st.XepLoai_Style === 'average') ? 'b-info' : (st.XepLoai_Style === 'average-low') ? 'b-secondary' : (st.XepLoai_Style === 'fail') ? 'b-warn' : '' %>
                      <span class="badge <%= xlStyle %>"><%= st.XepLoai %></span>
                    </td>

                    <% if (canManageStudents) { %>
                      <td class="text-center">
                        <button class="btn btn-sm btn-edit" type="button">Sửa</button>
                        <button class="btn btn-sm btn-delete" type="button">Xóa</button>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="<%= canManageStudents ? 9 : 8 %>" class="text-center muted">
                    Chưa có dữ liệu học sinh trong hệ thống.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <button class="btn-page" disabled>‹</button>
          <span class="page-info">Trang <strong>1</strong> / <strong>1</strong></span>
          <button class="btn-page" disabled>›</button>
        </div>
      </section>
    </main>
  </div>

  <script>
(function() {
  const searchInput  = document.getElementById('search-name');
  const filterGender = document.getElementById('filter-gender');
  const filterClass  = document.getElementById('filter-class');
  const rows         = document.querySelectorAll('#tbl-students tbody tr[data-mahs]');

  function applyFilter(){
    const q  = (searchInput.value || '').toLowerCase();
    const g  = (filterGender.value || '').toLowerCase();
    const cl = (filterClass.value  || '').toLowerCase();

    let visibleCount = 0;
    rows.forEach(tr => {
      const name   = tr.getAttribute('data-name')   || '';
      const gender = tr.getAttribute('data-gender') || '';
      const clazz  = tr.getAttribute('data-class')  || '';

      const okQ  = !q  || name.includes(q);
      const okG  = !g  || gender === g;
      const okCl = !cl || clazz === cl;

      if (okQ && okG && okCl) {
        tr.style.display = '';
        visibleCount++;
      } else {
        tr.style.display = 'none';
      }
    });
  }

  searchInput && searchInput.addEventListener('input', applyFilter);
  filterGender && filterGender.addEventListener('change', applyFilter);
  filterClass && filterClass.addEventListener('change', applyFilter);

  // Khi đổi năm học, reload page để tính toán lại TB/HK/Xếp loại dựa trên Năm học
  const filterYear = document.getElementById('filter-year');
  filterYear && filterYear.addEventListener('change', function(){
    const y = this.value;
    const params = new URLSearchParams(window.location.search);
    if (y) params.set('year', y); else params.delete('year');
    window.location.search = params.toString();
  });
})();

// PHẦN 2: THÊM HỌC SINH
(function () {
  const overlayAdd   = document.getElementById('student-overlay');
  const btnAdd       = document.getElementById('btn-add');
  const btnCancelAdd = document.getElementById('btn-cancel-student');

  function openAdd()  { 
    if (overlayAdd) {
      overlayAdd.style.display = 'grid';
      const form = overlayAdd.querySelector('form');
      if (form) form.reset();
    }
  }
  
  function closeAdd() { 
    if (overlayAdd) overlayAdd.style.display = 'none';
  }

  btnAdd       && btnAdd.addEventListener('click', openAdd);
  btnCancelAdd && btnCancelAdd.addEventListener('click', closeAdd);
  overlayAdd   && overlayAdd.addEventListener('click', e => {
    if (e.target === overlayAdd) closeAdd();
  });
})();

(function() {
  const overlayEdit   = document.getElementById('student-edit-overlay');
  const btnCancelEdit = document.getElementById('btn-cancel-edit');

  const inputEditMaHS     = document.getElementById('editMaHocSinh');
  const inputEditHoTen    = document.getElementById('editHoTen');
  const selectEditGT      = document.getElementById('editGioiTinh');
  const inputEditNgaySinh = document.getElementById('editNgaySinh');
  const inputEditDiaChi   = document.getElementById('editDiaChi');
  const inputEditEmail    = document.getElementById('editEmail');
  const inputEditMaLop    = document.getElementById('editMaLop');
  
  let inputOldMaHS = document.getElementById('oldMaHocSinh');
  if (!inputOldMaHS && overlayEdit) {
    const form = overlayEdit.querySelector('form');
    if (form) {
      inputOldMaHS = document.createElement('input');
      inputOldMaHS.type = 'hidden';
      inputOldMaHS.name = 'OldMaHocSinh';
      inputOldMaHS.id = 'oldMaHocSinh';
      form.appendChild(inputOldMaHS);
    }
  }

  function openEdit()  { 
    if (overlayEdit) overlayEdit.style.display = 'grid';
  }
  
  function closeEdit() { 
    if (overlayEdit) overlayEdit.style.display = 'none';
  }

  btnCancelEdit && btnCancelEdit.addEventListener('click', closeEdit);
  overlayEdit   && overlayEdit.addEventListener('click', e => {
    if (e.target === overlayEdit) closeEdit();
  });

  document.querySelectorAll('.btn-edit').forEach(btn => {
    btn.addEventListener('click', function () {
      const tr = this.closest('tr');
      if (!tr) return;

      const mahs = tr.getAttribute('data-mahs') || '';
      const hoten = tr.getAttribute('data-hoten') || '';
      const gioitinh = tr.getAttribute('data-gioitinh') || '';
      const ngaysinh = tr.getAttribute('data-ngaysinh') || '';
      const diachi = tr.getAttribute('data-diachi') || '';
      const email = tr.getAttribute('data-email') || '';
      const malop = tr.getAttribute('data-malop') || '';

      if (inputEditMaHS) {
        inputEditMaHS.value = mahs;
        inputEditMaHS.removeAttribute('readonly');
      }
      
      if (inputOldMaHS) {
        inputOldMaHS.value = mahs;
      }
      
      if (inputEditHoTen) inputEditHoTen.value = hoten;
      if (selectEditGT) selectEditGT.value = gioitinh;
      if (inputEditNgaySinh) {
        const dateMatch = ngaysinh.match(/(\d{4})-(\d{2})-(\d{2})/);
        inputEditNgaySinh.value = dateMatch ? `${dateMatch[1]}-${dateMatch[2]}-${dateMatch[3]}` : ngaysinh.substring(0,10);
      }
      if (inputEditDiaChi) inputEditDiaChi.value = diachi;
      if (inputEditEmail) inputEditEmail.value = email;
      if (inputEditMaLop) inputEditMaLop.value = malop;

      console.log('📝 Sửa học sinh - Mã cũ:', mahs);
      openEdit();
    });
  });
})();

(function() {
  document.querySelectorAll('.btn-delete').forEach(btn => {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      
      const tr = this.closest('tr');
      if (!tr) return;
      
      const mahs = tr.getAttribute('data-mahs');
      const hoten = tr.getAttribute('data-hoten') || 'học sinh này';

      if (!mahs) {
        alert('Không tìm thấy mã học sinh!');
        return;
      }

      if (confirm(`Bạn có chắc chắn muốn xóa học sinh "${hoten}" (${mahs}) không?\n\nLưu ý: Tất cả điểm số và điểm danh sẽ bị xóa.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/student/delete';
        
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'MaHocSinh';
        input.value = mahs;
        
        form.appendChild(input);
        document.body.appendChild(form);
        
        console.log('🗑️ Xóa học sinh:', mahs);
        form.submit();
      }
    });
  });
})();

(function() {
  const btnExport = document.getElementById('btn-export');
  
  if (btnExport) {
    btnExport.addEventListener('click', function () {
      const rows = document.querySelectorAll('#tbl-students tbody tr[data-mahs]');
      
      if (rows.length === 0) {
        alert('Không có dữ liệu để xuất!');
        return;
      }
      
      let csvContent = 'STT,Mã HS,Họ Tên,Giới Tính,Ngày Sinh,Địa Chỉ,Email,Lớp,TB HK1,TB HK2,TB CN,Hạnh kiểm,Xếp loại\n';
      
      let count = 0;
      rows.forEach((tr) => {
        if (tr.style.display !== 'none') {
          count++;
          const mahs = tr.getAttribute('data-mahs') || '';
          const hoten = tr.getAttribute('data-hoten') || '';
          const gioitinh = tr.getAttribute('data-gioitinh') || '';
          const ngaysinh = tr.getAttribute('data-ngaysinh') || '';
          const diachi = tr.getAttribute('data-diachi') || '';
          const email = tr.getAttribute('data-email') || '';
          const malop = tr.getAttribute('data-malop') || '';
          const tbhk1 = tr.getAttribute('data-tbhk1') || '';
          const tbhk2 = tr.getAttribute('data-tbhk2') || '';
          const tbcn  = tr.getAttribute('data-tbcn')  || '';
          const hanhkiem = tr.getAttribute('data-hanhkiem') || '';
          const xeploai  = tr.getAttribute('data-xeploai')  || '';

          csvContent += `${count},"${mahs}","${hoten}","${gioitinh}","${ngaysinh}","${diachi}","${email}","${malop}","${tbhk1}","${tbhk2}","${tbcn}","${hanhkiem}","${xeploai}"\n`;
        }
      });
      
      const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      
      link.setAttribute('href', url);
      link.setAttribute('download', `danh_sach_hoc_sinh_${new Date().getTime()}.csv`);
      link.style.visibility = 'hidden';
      
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      
      alert(`Đã xuất ${count} học sinh ra file Excel!`);
    });
  }
})();

console.log('Student Management - Thêm/Sửa/Xóa hoạt động!');
  </script>

  <form id="form-delete-student" method="POST" action="/student/delete" style="display:none;">
    <input type="hidden" name="MaHocSinh" id="deleteMaHocSinh" />
  </form>
</body>
</html>