<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page-student">
    <div class="layout">
        <%- include('../partials/sidebar') %>

        <main class="main">
            <% 
                // Defensive check: đảm bảo isStudent luôn được định nghĩa
                const isStudentFlag = (typeof isStudent !== 'undefined' && isStudent === true) ? true : false;
            %>
            <div class="page-header">
                <h1 class="page-title"><%= isStudentFlag ? 'Bảng điểm cá nhân' : 'Bảng điểm' %></h1>
                <p class="page-desc"><%= isStudentFlag ? 'Xem điểm số và kết quả học tập của bạn' : 'Chuyển tab để xem danh sách học sinh hoặc bảng điểm môn học theo năm/kỳ.' %></p>
                <% if (error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>
                <% if (success) { %>
                    <div class="alert alert-success"><%= success %></div>
                <% } %>
            </div>
            
            <div class="report-buttons">
                <button class="report-btn active" data-report="students" onclick="switchTab('students')">
                    <div class="report-btn-icon">🧑‍🎓</div>
                    <div>
                        <div class="report-btn-title"><%= isStudentFlag ? 'Kết quả học tập' : 'Danh sách học sinh' %></div>
                        <div class="report-btn-desc"><%= isStudentFlag ? 'Tổng quan điểm & xếp loại cả năm' : 'Tổng quan lớp & xếp loại cả năm' %></div>
                    </div>
                </button>
                <button class="report-btn" data-report="subject" onclick="switchTab('subject')">
                    <div class="report-btn-icon">📘</div>
                    <div>
                        <div class="report-btn-title">Bảng điểm môn học</div>
                        <div class="report-btn-desc">Điểm 1p · 1 tiết · CK · TB môn</div>
                    </div>
                </button>
            </div>

            <section id="tab-students" class="report-content active">
                <% if (!isStudentFlag) { %>
                <section class="card" style="margin-bottom:16px;">
                    <div class="report-filter-grid">
                        <div class="class-info-item">
                            <label class="class-label">Năm học</label>
                            <select class="select class-select" id="year-students">
                                <% years.forEach(year => { %>
                                    <option value="<%= year %>" <%= (selectedYear === year) ? 'selected' : '' %>><%= year %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="class-info-item">
                            <label class="class-label">Lọc lớp</label>
                            <select class="select class-select" id="class-students">
                                <option value="">Tất cả</option>
                                <% classes.forEach(lop => { %>
                                    <option value="<%= lop.MaLop %>"><%= lop.MaLop %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="class-info-item">
                            <label class="class-label">Tìm kiếm</label>
                            <input class="input" id="search-students" placeholder="Họ tên hoặc lớp..." />
                        </div>
                    </div>
                </section>
                <% } else { %>
                <section class="card" style="margin-bottom:16px;">
                    <div class="report-filter-grid">
                        <div class="class-info-item">
                            <label class="class-label">Năm học</label>
                            <select class="select class-select" id="year-students">
                                <% years.forEach(year => { %>
                                    <option value="<%= year %>" <%= (selectedYear === year) ? 'selected' : '' %>><%= year %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </section>
                <% } %>
                <section class="card">
                    <div class="table-wrap" style="overflow:auto; max-height:520px;">
                        <table class="table" id="tbl-students">
                            <thead>
                                <tr>
                                    <th style="width:70px;">STT</th>
                                    <th style="width:220px;">Họ tên</th>
                                    <th style="width:100px;">Lớp</th>
                                    <th style="width:120px;">TB HK1</th>
                                    <th style="width:120px;">TB HK2</th>
                                    <th style="width:120px;">Cả năm</th>
                                    <th style="width:140px;">Hạnh kiểm</th>
                                    <th style="width:120px;">Xếp loại</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% // Dữ liệu D3 (Danh sách học sinh) %>
                                <% if (studentsOverview && studentsOverview.length > 0) { %>
                                    <% studentsOverview.forEach((student, index) => { %>
                                    <tr>
                                        <td class="text-center"><%= index + 1 %></td>
                                        <td><%= student.HoTen %></td>
                                        <td><%= student.MaLop %></td>
                                        <td class="score-cell"><span class="score score-<%= student.TB_HK1_Style %>"><%= (typeof student.TB_HK1 === 'number') ? student.TB_HK1.toFixed(1) : '0.0' %></span></td>
                                        <td class="score-cell"><span class="score score-<%= student.TB_HK2_Style %>"><%= (typeof student.TB_HK2 === 'number') ? student.TB_HK2.toFixed(1) : '0.0' %></span></td>
                                        <td class="score-cell"><span class="score score-<%= student.TB_CN_Style %>"><%= (typeof student.TB_CN === 'number') ? student.TB_CN.toFixed(1) : '0.0' %></span></td>
                                        <td><span class="badge b-<%= student.HanhKiem_Style %>"><%= student.HanhKiem %></span></td>
                                        <td><span class="badge b-<%= student.XepLoai_Style %>"><%= student.XepLoai %></span></td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center">Không có học sinh cho Năm học này hoặc dữ liệu đang trống.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination">
                        <button class="btn-page" disabled>‹</button>
                        <span class="page-info">Trang <strong>1</strong> / <strong>1</strong></span>
                        <button class="btn-page" disabled>›</button>
                    </div>
                </section>
            </section>

            <section id="tab-subject" class="report-content">
                <section class="card" style="margin-bottom:16px;">
                    <div class="report-filter-grid-3 compact-filters">
                        <div class="class-info-item">
                            <label class="class-label">Năm học</label>
                            <select class="select class-select select-sm" id="year-subject">
                                <% years.forEach(year => { %>
                                    <option value="<%= year %>" <%= (selectedYear === year) ? 'selected' : '' %>><%= year %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="class-info-item">
                            <label class="class-label">Kỳ học</label>
                            <select class="select class-select select-sm" id="semester-subject">
                                <option value="1" <%= (selectedSemester === '1') ? 'selected' : '' %>>Học kỳ 1</option>
                                <option value="2" <%= (selectedSemester === '2') ? 'selected' : '' %>>Học kỳ 2</option>
                            </select>
                        </div>
                        <div class="class-info-item">
                            <label class="class-label">Môn học</label>
                            <select class="select class-select select-sm" id="subject-subject">
                                <% subjects.forEach(subject => { %>
                                    <option value="<%= subject.MaMonHoc %>" <%= (selectedSubject === subject.MaMonHoc) ? 'selected' : '' %>><%= subject.TenMonHoc %></option>
                                <% }); %>
                            </select>
                        </div>
                        <% if (!isStudentFlag) { %>
                        <div class="class-info-item">
                            <label class="class-label">Lọc lớp</label>
                            <select class="select class-select select-sm" id="class-subject">
                                <option value="" <%= (typeof selectedClass === 'undefined' || !selectedClass) ? 'selected' : '' %>>Tất cả</option>
                                <% classes.forEach(lop => { %>
                                    <option value="<%= lop.MaLop %>" <%= (typeof selectedClass !== 'undefined' && selectedClass === lop.MaLop) ? 'selected' : '' %>><%= lop.MaLop %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="class-info-item" style="display:flex; align-items:center; gap:8px;">
                            <button class="btn btn-sm" id="btn-import-excel">Import Excel</button>
                            <small style="font-size:12px; color:#666;">(File Excel 8 cột: HoTen, HocKy, Namhoc, MonHoc, Diem15p, Diem1Tiet, DiemCK, DiemTBM)</small>
                            <form id="frm-import" action="/scoretable/import" method="post" enctype="multipart/form-data" style="display:none;">
                                <input type="file" name="scoreFile" id="scoreFile" accept=".xls,.xlsx" />
                            </form>
                        </div>
                        <% } %>
                    </div>
                </section>
                <section class="card">
                    <div class="table-wrap" style="overflow:auto; max-height:520px;">
                        <table class="table table-scores" id="tbl-subject">
                            <thead>
                                <tr>
                                    <th style="width:70px;">STT</th>
                                    <th style="width:220px;">Họ tên</th>
                                    <th style="width:120px;">Điểm 15p</th>
                                    <th style="width:120px;">Điểm 1 tiết</th>
                                    <th style="width:120px;">Điểm CK</th>
                                    <th style="width:140px;">Điểm TB môn</th>
                                    <% if (!isStudentFlag) { %>
                                    <th style="width:120px;">Sửa điểm</th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% // Dữ liệu D6 (Danh sách điểm môn học chi tiết) %>
                                <% if (subjectScores && subjectScores.length > 0) { %>
                                    <% subjectScores.forEach((score, index) => { %>
                                    <tr data-id="<%= score.MaHocSinh %>" data-ho-ten="<%= score.HoTen %>" data-diem15p="<%= (typeof score.Diem15p === 'number') ? score.Diem15p.toFixed(1) : '' %>" data-diem1tiet="<%= (typeof score.Diem1Tiet === 'number') ? score.Diem1Tiet.toFixed(1) : '' %>" data-diemck="<%= (typeof score.DiemCK === 'number') ? score.DiemCK.toFixed(1) : '' %>">
                                        <td class="text-center"><%= index + 1 %></td>
                                        <td><%= score.HoTen %></td>
                                        <td class="score-cell"><span class="score score-<%= score.Diem15p_Style %>"><%= (typeof score.Diem15p === 'number') ? score.Diem15p.toFixed(1) : '0.0' %></span></td>
                                        <td class="score-cell"><span class="score score-<%= score.Diem1Tiet_Style %>"><%= (typeof score.Diem1Tiet === 'number') ? score.Diem1Tiet.toFixed(1) : '0.0' %></span></td>
                                        <td class="score-cell"><span class="score score-<%= score.DiemCK_Style %>"><%= (typeof score.DiemCK === 'number') ? score.DiemCK.toFixed(1) : '0.0' %></span></td>
                                        <td class="score-cell"><span class="score score-<%= score.DiemTB_Style %>"><%= (typeof score.DiemTB === 'number') ? score.DiemTB.toFixed(1) : '0.0' %></span></td>
                                        <% if (!isStudentFlag) { %>
                                        <td class="action-cell">
                                            <button class="btn btn-sm btn-ghost" onclick="openEditModal(<%= score.MaHocSinh %>)">Sửa</button>
                                            <button class="btn btn-sm btn-danger" onclick="openDeleteConfirm(<%= score.MaHocSinh %>)">Xóa</button>
                                        </td>
                                        <% } %>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="<%= isStudentFlag ? 6 : 7 %>" class="text-center">Không có học sinh cho Năm học / Học kỳ này hoặc chưa có dữ liệu môn học.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination">
                        <button class="btn-page" disabled>‹</button>
                        <span class="page-info">Trang <strong>1</strong> / <strong>1</strong></span>
                        <button class="btn-page" disabled>›</button>
                    </div>
                </section>
            </section>
        </main>
    </div>

    <script>
        // Hàm switchTab giữ nguyên
        function switchTab(target){
            document.querySelectorAll('.report-btn').forEach(b=>b.classList.remove('active'));
            document.querySelectorAll('.report-content').forEach(c=>c.classList.remove('active'));
            document.querySelector('[data-report="'+target+'"]').classList.add('active');
            document.getElementById('tab-'+target).classList.add('active');
            history.replaceState(null, '', `?tab=${target}<% if (selectedYear) { %>&year=<%= selectedYear %><% } %>`);
        }
        window.addEventListener('DOMContentLoaded', ()=>{
            // Đọc tab từ query param hoặc mặc định là 'students'
            const urlParams = new URLSearchParams(window.location.search);
            const t = urlParams.get('tab') || 'students'; 
            switchTab(t)
        });

        // Hàm xử lý lọc dữ liệu (Giữ nguyên)
        (function(){
            const search = document.getElementById('search-students');
            const cls    = document.getElementById('class-students');
            const tbody  = document.querySelector('#tbl-students tbody');

            function apply(){
                const q = (search.value||'').toLowerCase();
                const c = (cls.value||'').toLowerCase();
                tbody.querySelectorAll('tr').forEach(tr=>{
                    const name = tr.cells[1].textContent.toLowerCase();
                    const lop  = tr.cells[2].textContent.toLowerCase();
                    const okQ  = !q || name.includes(q) || lop.includes(q);
                    const okC  = !c || lop === c;
                    tr.style.display = (okQ && okC) ? '' : 'none';
                });
            }
            search && search.addEventListener('input', apply);
            cls && cls.addEventListener('change', apply);

            // Tự động gửi lại request khi filter Bảng điểm môn học thay đổi
            const yearStudentFilter = document.getElementById('year-students');
            if (yearStudentFilter) {
                yearStudentFilter.addEventListener('change', () => {
                    const year = yearStudentFilter.value;
                    // Chuyển hướng để Controller nhận request GET mới với params
                    window.location.href = `/scoretable?tab=students&year=${year}`;
                });
            }

            const subjectFilters = document.querySelectorAll('#year-subject, #semester-subject, #subject-subject, #class-subject');
            subjectFilters.forEach(filter => {
                filter.addEventListener('change', () => {
                    const year = document.getElementById('year-subject').value;
                    const semester = document.getElementById('semester-subject').value;
                    const subject = document.getElementById('subject-subject').value;
                    const classFilter = document.getElementById('class-subject') ? document.getElementById('class-subject').value : '';
                    window.location.href = `/scoretable?tab=subject&year=${year}&semester=${semester}&subject=${subject}&class=${encodeURIComponent(classFilter)}`;
                });
            });
        })();

        // Hàm mở modal Sửa điểm: đọc data- attributes từ hàng và hiển thị modal
        function openEditModal(studentId) {
            const row = document.querySelector(`#tbl-subject tr[data-id='${studentId}']`);
            if (!row) return alert('Không tìm thấy hàng học sinh.');

            const hoTen = row.getAttribute('data-ho-ten') || '';
            const d15 = row.getAttribute('data-diem15p') || '';
            const d1t = row.getAttribute('data-diem1tiet') || '';
            const dck = row.getAttribute('data-diemck') || '';

            document.getElementById('editStudentId').value = studentId;
            document.getElementById('editHoTen').textContent = hoTen;
            document.getElementById('editDiem15p').value = d15;
            document.getElementById('editDiem1Tiet').value = d1t;
            document.getElementById('editDiemCK').value = dck;

            // Set current filters so redirect after save returns to same view
            document.getElementById('editYear').value = document.getElementById('year-subject').value;
            document.getElementById('editHocKy').value = document.getElementById('semester-subject').value;
            document.getElementById('editMaMon').value = document.getElementById('subject-subject').value;

            document.getElementById('modal-edit').classList.add('open');
        }

        // Close modal
        function closeEditModal() {
            document.getElementById('modal-edit').classList.remove('open');
        }

        // Submit handler: simple client-side validation
        function submitEditForm(e) {
            e.preventDefault();
            const d15 = parseFloat(document.getElementById('editDiem15p').value) || 0;
            const d1t = parseFloat(document.getElementById('editDiem1Tiet').value) || 0;
            const dck = parseFloat(document.getElementById('editDiemCK').value) || 0;

            if (d15 < 0 || d1t < 0 || dck < 0) return alert('Điểm không được nhỏ hơn 0');

            document.getElementById('frm-edit').submit();
        }

        // Import Excel button logic
        document.getElementById('btn-import-excel') && document.getElementById('btn-import-excel').addEventListener('click', (e) => {
            e.preventDefault();
            document.getElementById('scoreFile').click();
        });
        document.getElementById('scoreFile') && document.getElementById('scoreFile').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            if (!confirm(`Bạn có chắc muốn import tệp '${file.name}' không?`)) {
                e.target.value = '';
                return;
            }
            document.getElementById('frm-import').submit();
        });

        // ========== EDIT MODAL HTML INJECTION ==========

        // Hàm xác nhận xóa: sử dụng form ẩn để POST tới endpoint xóa
        function openDeleteConfirm(studentId) {
            const row = document.querySelector(`#tbl-subject tr[data-id='${studentId}']`);
            if (!row) return alert('Không tìm thấy học sinh.');
            const hoTen = row.getAttribute('data-ho-ten') || '';
            if (!confirm(`Bạn có chắc muốn xóa tất cả điểm môn của học sinh "${hoTen}" không?`)) return;

            document.getElementById('delMaHocSinh').value = studentId;
            document.getElementById('delNamHoc').value = document.getElementById('year-subject').value;
            document.getElementById('delHocKy').value = document.getElementById('semester-subject').value;
            document.getElementById('delMaMon').value = document.getElementById('subject-subject').value;
            document.getElementById('frm-delete').submit();
        }
    </script>

    <!-- Edit modal -->
    <div id="modal-edit" class="modal">
        <div class="modal-backdrop" onclick="closeEditModal()"></div>
        <div class="modal-panel">
            <h3>Sửa điểm của <span id="editHoTen"></span></h3>
            <form id="frm-edit" method="post" action="/scoretable/update" onsubmit="submitEditForm(event)">
                <input type="hidden" name="MaHocSinh" id="editStudentId" />
                <input type="hidden" name="NamHoc" id="editYear" />
                <input type="hidden" name="HocKy" id="editHocKy" />
                <input type="hidden" name="MaMon" id="editMaMon" />

                <div style="display:flex; gap:8px; margin-bottom:8px;">
                    <label style="width:120px;">Điểm 15p</label>
                    <input class="input" name="Diem15p" id="editDiem15p" type="number" step="0.1" min="0" />
                </div>
                <div style="display:flex; gap:8px; margin-bottom:8px;">
                    <label style="width:120px;">Điểm 1 tiết</label>
                    <input class="input" name="Diem1Tiet" id="editDiem1Tiet" type="number" step="0.1" min="0" />
                </div>
                <div style="display:flex; gap:8px; margin-bottom:8px;">
                    <label style="width:120px;">Điểm CK</label>
                    <input class="input" name="DiemCK" id="editDiemCK" type="number" step="0.1" min="0" />
                </div>

                <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:12px;">
                    <button type="button" class="btn" onclick="closeEditModal()">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .modal{position:fixed; inset:0; display:none;}
        .modal.open{display:block}
        .modal-backdrop{position:absolute; inset:0; background:rgba(0,0,0,0.4)}
        .modal-panel{position:relative; width:480px; max-width:96%; margin:80px auto; background:white; padding:16px; border-radius:6px; box-shadow:0 6px 24px rgba(0,0,0,0.2)}
        .btn-danger{background:#ff4d4f;color:white;border:none;padding:6px 10px;border-radius:4px;margin-left:8px}
    </style>

    <!-- Hidden delete form -->
    <form id="frm-delete" method="post" action="/scoretable/delete" style="display:none;">
        <input type="hidden" name="MaHocSinh" id="delMaHocSinh" />
        <input type="hidden" name="NamHoc" id="delNamHoc" />
        <input type="hidden" name="HocKy" id="delHocKy" />
        <input type="hidden" name="MaMon" id="delMaMon" />
    </form>
</body>
</html>