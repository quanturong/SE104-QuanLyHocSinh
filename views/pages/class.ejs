<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Danh sách lớp – Quản lí học sinh</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="page-student">
  <div class="layout">
    <aside class="sidebar">
      <div class="brand">
        <div class="logo">🎓</div>
        <span>Student Management – Quản lí học sinh</span>
      </div>

      <% 
        // Lấy role từ user (backend render: user: req.session.user)
        const role = (user && user.role) ? user.role : ""; 
      %>

      <nav class="nav">
        <a class="<%= title === 'Bảng điều khiển' ? 'active' : '' %>" href="/tablecontrol">
          Bảng điều khiển
        </a>

        <% if (role !== 'HocSinh') { %>
          <a class="<%= title === 'Danh sách học sinh' ? 'active' : '' %>" href="/student">
            Học sinh
          </a>
          <a class="<%= title === 'Danh sách lớp' ? 'active' : '' %>" href="/class">
            Lớp học
          </a>
          <a class="<%= title === 'Điểm danh' ? 'active' : '' %>" href="/attendance">
            Điểm danh
          </a>
          <a class="<%= title === 'Báo cáo' ? 'active' : '' %>" href="/report">
            Báo cáo
          </a>
          <a class="<%= title === 'Bảng điểm' ? 'active' : '' %>" href="/scoretable">
            Điểm số
          </a>
          <a class="<%= title === 'Tra cứu hồ sơ học sinh' ? 'active' : '' %>" href="/find">
            Tra cứu
          </a>
        <% } %>

        <a class="<%= title === 'Thời khóa biểu' ? 'active' : '' %>" href="/timetable">
          Thời khóa biểu
        </a>
        <a class="<%= title === 'Danh sách giáo viên' ? 'active' : '' %>" href="/teacher">
          Giáo viên
        </a>
        <a class="<%= title === 'Quy định' ? 'active' : '' %>" href="/rules">
          Quy định
        </a>
        <% if (role === 'Admin') { %>
          <a class="<%= title === 'Tạo tài khoản' ? 'active' : '' %>" href="/create-user">
            👤 Tạo tài khoản
          </a>
        <% } %>
      </nav>

      <div class="spacer"></div>
      <a class="nav logout" href="/logout">Đăng xuất</a>
    </aside>

    <main class="main">
      <div class="page-header">
        <h1 class="page-title">Danh sách lớp học</h1>
        <p class="page-desc">
          Dữ liệu lấy từ bảng <strong>LopHoc</strong>. Chọn lớp để xem sĩ số.
        </p>
      </div>
      <section class="card" style="margin-bottom: 16px;">
        <div class="class-info-grid">
          <div class="class-info-item">
            <label class="class-label">Năm học</label>
            <select class="select class-select" id="select-year">
              <% if (namHocs && namHocs.length) { %>
                <% namHocs.forEach(function(nh, idx){ %>
                  <option value="<%= nh.MaNamHoc %>" <%= idx === 0 ? "selected" : "" %>>
                    <%= nh.MaNamHoc %>
                  </option>
                <% }) %>
              <% } else { %>
                <option>Chưa có năm học</option>
              <% } %>
            </select>
          </div>

          <div class="class-info-item">
            <label class="class-label">Lớp</label>

            <div style="display:flex; align-items:center; gap:10px;">
              <select class="select class-select" id="select-class">
                <option value="">-- Chọn lớp --</option>
                <% classes.forEach(cls => { %>
                  <option value="<%= cls.MaLop %>" data-siso="<%= cls.SiSoLop %>">
                    <%= cls.KhoiLop %> - <%= cls.MaLop %>
                  </option>
                <% }) %>
              </select>

              <button id="btn-view" class="btn btn-view-small">
                Xem
              </button>
            </div>
          </div>

      </section>

      <section class="card">
        <div class="table-wrap" style="overflow:auto; max-height:560px;">
          <table class="table" id="tbl-classes">
            <thead>
              <tr>
                <th style="width:60px;">STT</th>
                <th style="width:120px;">MÃ LỚP</th>
                <th style="width:90px;">KHỐI</th>
                <th style="width:100px;">SĨ SỐ</th>
                <th style="width:120px;">MÃ GVCN</th>
              </tr>
            </thead>
            <tbody>
              <% if (classes && classes.length) { %>
                <% classes.forEach(function(cls, index){ %>
                  <tr
                    data-class="<%= (cls.MaLop || '').toLowerCase() %>"
                    data-siso="<%= cls.SiSoLop || 0 %>"
                  >
                    <td class="text-center"><%= index + 1 %></td>
                    <td class="text-center"><%= cls.MaLop %></td>
                    <td class="text-center"><%= cls.KhoiLop %></td>
                    <td class="text-center"><%= cls.SiSoLop || 0 %></td>
                    <td class="text-center"><%= cls.MaGVCN || '' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center muted">
                    Chưa có lớp trong hệ thống.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <button class="btn-page" disabled>‹</button>
          <span class="page-info">Trang <strong>1</strong> / <strong>1</strong></span>
          <button class="btn-page" disabled>›</button>
        </div>
      </section>
      <% if (typeof studentsInClass !== 'undefined' && studentsInClass) { %>

      <section class="card" style="margin-top:16px;">
        <h3>Danh sách học sinh – Lớp <%= selectedClass %></h3>

        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>STT</th>
                <th>MÃ HS</th>
                <th>HỌ TÊN</th>
                <th>GIỚI TÍNH</th>
                <th>NGÀY SINH</th>
                <th>ĐỊA CHỈ</th>
                <th>EMAIL</th>
              </tr>
            </thead>
            <tbody>
              <% if (studentsInClass.length === 0) { %>
                <tr><td colspan="7" class="text-center">Không có học sinh.</td></tr>
              <% } else { %>
                <% studentsInClass.forEach(function(st, idx){ %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= st.MaHocSinh %></td>
                    <td><%= st.HoTen %></td>
                    <td><%= st.GioiTinh %></td>
                    <td><%= st.NgaySinh %></td>
                    <td><%= st.DiaChi %></td>
                    <td><%= st.Email %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
      <% } %>

    </main>
  </div>

  <script>
    (function() {
      const selectClass = document.getElementById('select-class');
      const countNumber = document.getElementById('count-number');

      function updateCount() {
        const opt = selectClass.options[selectClass.selectedIndex];
        if (!opt || !opt.getAttribute) return;
        const siso = opt.getAttribute('data-siso');
        countNumber.textContent = siso !== null ? siso : '--';
      }

      selectClass && selectClass.addEventListener('change', updateCount);
    })();
  </script>
  <script>
  document.getElementById("btn-view").addEventListener("click", function () {
    const lop = document.getElementById("select-class").value;

    if (!lop) {
      alert("Vui lòng chọn lớp!");
      return;
    }

    window.location.href = `/class/view?lop=${lop}`;
  });
  </script>

</body>
</html>