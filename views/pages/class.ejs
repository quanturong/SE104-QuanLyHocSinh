<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Danh sách lớp – Quản lí học sinh</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="page-student">
<div class="layout">

  <%- include('../partials/sidebar') %>

  <main class="main">

    <!-- HEADER -->
    <div class="page-header">
      <h1 class="page-title">Danh sách lớp học</h1>
      <p class="page-desc">
        Dữ liệu lấy từ bảng <strong>LopHoc</strong>. Chọn lớp để xem sĩ số.
      </p>
    </div>

    <!-- FILTER -->
    <section class="card" style="margin-bottom:16px;">
      <div class="ttb-filter-inline">

        <div class="class-info-item">
          <label class="class-label">Năm học</label>
          <select class="select class-select" id="select-year">
            <% namHocs.forEach((nh, idx) => { %>
              <option value="<%= nh.MaNamHoc %>" <%= idx === 0 ? 'selected' : '' %>>
                <%= nh.MaNamHoc %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="class-info-item">
          <label class="class-label">Lớp</label>
          <div style="display:flex; gap:10px;">
            <select class="select class-select" id="select-class">
              <option value="">-- Chọn lớp --</option>
              <% classes.forEach(cls => { %>
                <option value="<%= cls.MaLop %>">
                  <%= cls.KhoiLop %> - <%= cls.MaLop %>
                </option>
              <% }) %>
            </select>

            <button id="btn-view" class="btn btn-sm">
              Xem
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- TABLE LỚP -->
    <section class="card">
      <div class="table-wrap">
        <table class="table" id="tbl-classes" style="table-layout: fixed; width: 100%;">
          <thead>
            <tr>
              <th style="width: 10%;">STT</th>
              <th style="width: 20%;">MÃ LỚP</th>
              <th style="width: 15%;">KHỐI</th>
              <th style="width: 15%;">SĨ SỐ</th>
              <th style="width: 40%;">GIÁO VIÊN CHỦ NHIỆM</th>
            </tr>
          </thead>
          <tbody>
            <% if (classes && classes.length) { %>
              <% classes.forEach((cls, index) => { %>
                <tr>
                  <td style="text-align: center;"><%= index + 1 %></td>
                  <td style="text-align: center;"><%= cls.MaLop %></td>
                  <td style="text-align: center;"><%= cls.KhoiLop %></td>
                  <td style="text-align: center;"><%= cls.SiSoLop %></td>
                  <td style="text-align: center;"><%= cls.TenGVChuNhiem || 'Chưa có' %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center muted">
                  Chưa có lớp trong hệ thống.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="pagination">
        <button class="btn-page" disabled>‹</button>
        <span class="page-info">Trang <strong>1</strong> / <strong>1</strong></span>
        <button class="btn-page" disabled>›</button>
      </div>
    </section>

    <!-- TABLE HỌC SINH -->
    <section class="card" style="margin-top:16px;">
      <h3>
        Danh sách học sinh
        <% if (selectedClass) { %> – Lớp <%= selectedClass %><% } %>
      </h3>

      <div class="table-wrap">
        <table class="table" id="tbl-students">
          <thead>
            <tr>
              <th>STT</th>
              <th>HỌ TÊN</th>
              <th>MÃ HS</th>
              <th>GIỚI TÍNH</th>
              <th>NGÀY SINH</th>
              <th>ĐỊA CHỈ</th>
              <th>EMAIL</th>
            </tr>
          </thead>
          <tbody>
            <% if (!selectedClass) { %>
              <tr>
                <td colspan="7" class="text-center muted">
                  Vui lòng chọn lớp để xem danh sách học sinh.
                </td>
              </tr>
            <% } else if (!studentsInClass || studentsInClass.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center muted">
                  Không có học sinh trong lớp này.
                </td>
              </tr>
            <% } else { %>
              <% studentsInClass.forEach((st, idx) => { %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><%= st.HoTen %></td>
                  <td><%= st.MaHocSinh %></td>
                  <td><%= st.GioiTinh || '' %></td>
                  <td>
                    <%= st.NgaySinh ? new Date(st.NgaySinh).toLocaleDateString('vi-VN') : '' %>
                  </td>
                  <td><%= st.DiaChi || '' %></td>
                  <td><%= st.Email || '' %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

  </main>
</div>

<script>
document.getElementById("btn-view").addEventListener("click", function () {
  const lop = document.getElementById("select-class").value;
  if (!lop) {
    alert("Vui lòng chọn lớp!");
    return;
  }
  window.location.href = `/class/view?lop=${lop}`;
});
</script>

</body>
</html>
