<aside class="sidebar">
  <div class="brand">
    <div class="logo">🎓</div>
    <span>Student Management – Quản lí học sinh</span>
  </div>

  <% 
    // Lấy role từ user (backend render: user: req.session.user)
    // Xử lý trường hợp user có thể undefined (defensive programming)
    // Trong EJS, nếu biến không tồn tại, nó sẽ là undefined
    const userObj = (typeof user !== 'undefined' && user !== null) ? user : null;
    const role = (userObj && userObj.role) ? String(userObj.role).trim() : "";
    
    // Xác định các quyền
    const isAdmin = role === 'Admin';
    const isBGH = role === 'BGH';
    const isGiaoVu = role === 'GiaoVu';
    const isGiaoVien = role === 'GiaoVien';
    const isHocSinh = role === 'HocSinh';
    const isStaff = !isHocSinh; // Tất cả trừ học sinh
    const canManageSubjects = isAdmin || isBGH || isGiaoVu;
  %>

  <nav class="nav">
    <!-- Tất cả người dùng đều thấy -->
    <a class="<%= title === 'Bảng điều khiển' ? 'active' : '' %>" href="/tablecontrol">
      Bảng điều khiển
    </a>

    <!-- Chỉ nhân viên (không phải học sinh) -->
    <% if (isStaff) { %>
      <a class="<%= title === 'Danh sách học sinh' ? 'active' : '' %>" href="/student">
        Học sinh
      </a>
      <a class="<%= title === 'Danh sách lớp' ? 'active' : '' %>" href="/class">
        Lớp học
      </a>
      <a class="<%= title === 'Điểm danh' ? 'active' : '' %>" href="/attendance">
        Điểm danh
      </a>
      <a class="<%= title === 'Báo cáo' ? 'active' : '' %>" href="/report">
        Báo cáo
      </a>
      <a class="<%= title === 'Tra cứu' ? 'active' : '' %>" href="/find">
        Tra cứu
      </a>
    <% } %>

    <!-- Tất cả người dùng đều thấy -->
    <a class="<%= title === 'Bảng điểm' ? 'active' : '' %>" href="/scoretable">
      Điểm số
    </a>

    <!-- Tất cả người dùng đều thấy -->
    <a class="<%= title === 'Thời khóa biểu' ? 'active' : '' %>" href="/timetable">
      Thời khóa biểu
    </a>

    <!-- Chỉ nhân viên (không phải học sinh) -->
    <% if (isStaff) { %>
      <a class="<%= title === 'Danh sách giáo viên' ? 'active' : '' %>" href="/teacher">
        Giáo viên
      </a>
    <% } %>

    <!-- Chỉ Admin, BGH, GiaoVu -->
    <% if (canManageSubjects) { %>
      <a class="<%= title === 'Quản lý môn học' ? 'active' : '' %>" href="/subject">
        📚 Môn học
      </a>
    <% } %>

    <!-- Tất cả người dùng đều thấy -->
    <a class="<%= title === 'Quy định' ? 'active' : '' %>" href="/rules">
      Quy định
    </a>

    <!-- Chỉ Admin -->
    <% if (isAdmin) { %>
      <a class="<%= title === 'Tạo tài khoản' ? 'active' : '' %>" href="/create-user">
        👤 Tạo tài khoản
      </a>
    <% } %>
  </nav>

  <div class="spacer"></div>
  <a class="nav logout" href="/logout">Đăng xuất</a>
</aside>

