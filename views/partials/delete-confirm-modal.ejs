<!-- Modal xác nhận xóa -->
<div id="delete-confirm-modal" class="sp-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10000; align-items: center; justify-content: center;">
  <div class="sp-modal" style="background: white; border-radius: 12px; padding: 24px; max-width: 480px; width: 90%; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
    <div style="text-align: center; margin-bottom: 20px;">
      <div style="width: 64px; height: 64px; margin: 0 auto 16px; background: #fee; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
        <span style="font-size: 32px;">⚠️</span>
      </div>
      <h3 style="margin: 0 0 8px; font-size: 20px; color: #333;">Xác nhận xóa</h3>
      <p id="delete-confirm-message" style="margin: 0; color: #666; font-size: 14px; line-height: 1.5;">
        Bạn có chắc chắn muốn xóa mục này?
      </p>
      <p id="delete-confirm-warning" style="margin: 12px 0 0; color: #c33; font-size: 13px; font-weight: 500; display: none;">
        ⚠️ Hành động này không thể hoàn tác!
      </p>
    </div>
    
    <div style="display: flex; gap: 12px; margin-top: 24px;">
      <button id="delete-confirm-cancel" class="btn btn-ghost" style="flex: 1;">
        Hủy
      </button>
      <button id="delete-confirm-ok" class="btn" style="flex: 1; background: #dc3545; color: white;">
        Xóa
      </button>
    </div>
  </div>
</div>

<script>
(function() {
  let deleteCallback = null;
  const modal = document.getElementById('delete-confirm-modal');
  const messageEl = document.getElementById('delete-confirm-message');
  const warningEl = document.getElementById('delete-confirm-warning');
  const cancelBtn = document.getElementById('delete-confirm-cancel');
  const okBtn = document.getElementById('delete-confirm-ok');

  function showDeleteConfirm(message, warning, callback) {
    messageEl.textContent = message || 'Bạn có chắc chắn muốn xóa mục này?';
    if (warning) {
      warningEl.textContent = warning;
      warningEl.style.display = 'block';
    } else {
      warningEl.style.display = 'none';
    }
    deleteCallback = callback;
    modal.style.display = 'flex';
  }

  function hideDeleteConfirm() {
    if (modal) {
      modal.style.display = 'none';
    }
    deleteCallback = null;
  }

  cancelBtn.addEventListener('click', hideDeleteConfirm);
  okBtn.addEventListener('click', function() {
    if (deleteCallback) {
      deleteCallback();
    }
    hideDeleteConfirm();
  });

  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      hideDeleteConfirm();
    }
  });

  // Expose globally
  window.showDeleteConfirm = showDeleteConfirm;
  window.hideDeleteConfirm = hideDeleteConfirm;
})();
</script>

<style>
.sp-overlay {
  animation: fadeIn 0.2s ease;
}

.sp-modal {
  animation: slideUp 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>

