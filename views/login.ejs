<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Student Management – Đăng nhập' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="auth">
  <main class="auth-card">
    <div class="auth-logo">
      <img src="/img/login.png" alt="Logo" />
    </div>

    <h1 class="auth-title">Student Management</h1>

    <% if (typeof error !== "undefined" && error) { %>
      <p class="auth-error"><%= error %></p>
    <% } %>

    <form class="auth-form" method="POST" action="/login">
      <label class="auth-label">
        Tên đăng nhập
        <input
          class="auth-input"
          name="username"
          type="text"
          placeholder="Nhập tên đăng nhập"
          required
        />
      </label>

      <label class="auth-label">
        Mật khẩu
        <input
          class="auth-input"
          name="password"
          type="password"
          placeholder="Nhập mật khẩu của bạn"
          required
        />
      </label>

      <button class="auth-btn" type="submit">Đăng nhập</button>
      

    </form>
    <a class="auth-link" href="/change-password">Quên mật khẩu?</a>
  </main>
</body>
</html>
